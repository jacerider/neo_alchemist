{%
  set classes = [
    'card flex flex-col md:flex-row gap-6 items-center bg-base-0 text-base-0-content',
    color == 'base' ? 'bg-base-200 text-base-200-content',
    color == 'primary' ? 'bg-primary-500 text-primary-500-content',
    color == 'secondary' ? 'bg-secondary-500 text-secondary-500-content',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {% if a %}
    {{ a.b }}<br>
    {{ a.bb.c }}<br>
    {{ a.bb.image.src }}<br>
    {{ a.bb.cc.d }}
  {% endif %}

  {% if image %}
    <div>
      {# Size: {{ image.size }} #}
      {# {{ neo_image_style(image.src, image.size, image.alt) }} #}
      {{ neo_image_style(image.src, image.size|default({scaleCrop: {width: 300, height: 200}}), image.alt) }}
      {# {{ neo_image_style_url(image.src, image.size|default({scaleCrop: {width: 300, height: 200}}), image.alt) }} #}
    </div>
  {% endif %}
  <div>
    {% if markup %}
      <div class="prose max-w-none">{{ markup }}</div>
    {% endif %}
    <div class="flex flex-col gap-2">
      {% if tmp %}
        {{ tmp.one }}: {{ tmp.child.two }}
        {% if tmp.image %}
          {{ neo_image_style(tmp.image.src, {scaleCrop: {width: 100, height: 100}}, tmp.image.alt) }}
        {% endif %}
      {% endif %}
      {% if heading %}
        {% if heading.supertitle %}<div class="text-xs">{{ heading.supertitle }}</div>{% endif %}
        <h2 class="text-xl font-bold text-base-0-content">{{ heading.title }}</h2>
        {% if heading.subtitle %}<div class="text-sm">{{ heading.subtitle }}</div>{% endif %}
      {% endif %}
      {% if title %}
        <h2 class="text-xl font-bold text-base-0-content">{{ title }}</h2>
      {% endif %}
      {% if email %}
        <div><a class="btn" href="mailto:{{ email }}">{{ email }}</a></div>
      {% endif %}
      {% if link %}
        {{ link(link.title, link.uri)|neo_class('btn btn-sm') }}
      {% endif %}
      {% if items %}
        <ul class="list-disc list-inside">
          {% for item in items %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if url %}
        <div>Url: {{ neo_uri(url.uri, url.options) }}</div>
      {% endif %}
    </div>
  </div>
  {% if wow %}
    {%
      set wow_classes = [
        'p-6',
        wow.color == 'base' ? 'bg-base-200 text-base-200-content',
        wow.color == 'primary' ? 'bg-primary-500 text-primary-500-content',
        wow.color == 'secondary' ? 'bg-secondary-500 text-secondary-500-content',
      ]
    %}
    <div class="{{ wow_classes|join(" ") }}">
      {{ wow.more }} <strong>{{ wow.many}}</strong>
    </div>
  {% endif %}
  {% if sequence %}
    <div class="flex flex-col gap-6">
      {% for item in sequence %}
        <div class="flex items-center gap-2">
          {% if item.image %}
            {{ neo_image_style(item.image.src, {scaleCrop: {width: 100, height: 100}}, item.image.alt) }}
          {% endif %}
          <div class="flex flex-col">
            <div class="font-bold">{{ item.title }}</div>
            {% if item.url %}
              <div>{{ link('View Now', item.url.uri, item.url.options)|neo_class('btn btn-sm') }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
  {% if tmp_array %}
    <div>
      {% for entry in tmp_array %}
        <div>
          <div class="font-bold">{{ entry.title }}</div>
          <div>{{ entry.url.uri }}</div>
          <div>{{ neo_image(entry.image.src, image_size|default({sm: {op: "focal", width: 200, height: 100}}), entry.image.alt) }}</div>
          {# <div>{{ neo_image_style_url(entry.image.src, image_size|default({scaleCrop: {width: 200, height: 100}}), entry.image.alt) }}</div> #}
        </div>
      {% endfor %}
    </div>
  {% endif %}

</div>
