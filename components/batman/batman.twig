{%
  set classes = [
    'card flex flex-col md:flex-row gap-6 items-center bg-base-0 text-base-content-0',
    color == 'base' ? 'bg-base-200 text-base-content-200',
    color == 'primary' ? 'bg-primary-500 text-primary-content-500',
    color == 'secondary' ? 'bg-secondary-500 text-secondary-content-500',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {% if a %}
    {{ a.b }}<br>
    {{ a.bb.c }}<br>
    {{ a.bb.image.src }}<br>
    {{ a.bb.cc.d }}
  {% endif %}

  {% if image %}
    <div>
      {{ neo_image_style(image.src, {scaleCrop: {width: 300, height: 200}}, image.alt) }}
    </div>
  {% endif %}
  <div>
    {% if markup %}
      <div class="prose max-w-none">{{ markup }}</div>
    {% endif %}
    <div class="flex flex-col gap-2">
      {% if tmp %}
        {{ tmp.one }}: {{ tmp.child.two }}
        {% if tmp.image %}
          {{ neo_image_style(tmp.image.src, {scaleCrop: {width: 100, height: 100}}, tmp.image.alt) }}
        {% endif %}
      {% endif %}
      {% if heading %}
        {% if heading.supertitle %}<div class="text-xs">{{ heading.supertitle }}</div>{% endif %}
        <h2 class="text-xl font-bold text-base-content-0">{{ heading.title }}</h2>
        {% if heading.subtitle %}<div class="text-sm">{{ heading.subtitle }}</div>{% endif %}
      {% endif %}
      {% if title %}
        <h2 class="text-xl font-bold text-base-content-0">{{ title }}</h2>
      {% endif %}
      {% if email %}
        <div><a class="btn" href="mailto:{{ email }}">{{ email }}</a></div>
      {% endif %}
      {% if link %}
        {{ link(link.title, link.uri)|neo_class('btn btn-sm') }}
      {% endif %}
      {% if items %}
        <ul class="list-disc list-inside">
          {% for item in items %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if url %}
        <div>Url: {{ neo_uri(url.uri, url.options) }}</div>
      {% endif %}
    </div>
  </div>
  {% if wow %}
    {%
      set wow_classes = [
        'p-6',
        wow.color == 'base' ? 'bg-base-200 text-base-content-200',
        wow.color == 'primary' ? 'bg-primary-500 text-primary-content-500',
        wow.color == 'secondary' ? 'bg-secondary-500 text-secondary-content-500',
      ]
    %}
    <div class="{{ wow_classes|join(" ") }}">
      {{ wow.more }} <strong>{{ wow.many}}</strong>
    </div>
  {% endif %}
  {% if sequence %}
    <div class="flex flex-col gap-6">
      {% for item in sequence %}
        <div class="flex items-center gap-2">
          {% if item.image %}
            {{ neo_image_style(item.image.src, {scaleCrop: {width: 100, height: 100}}, item.image.alt) }}
          {% endif %}
          <div class="flex flex-col">
            <div class="font-bold">{{ item.title }}</div>
            {% if item.url %}
              <div>{{ link('View Now', item.url.uri, item.url.options)|neo_class('btn btn-sm') }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {# <a class="btn">Button</a>
  <a class="btn btn-outline">Button Outline</a>
  <a class="btn btn-primary">Primary</a>
  <a class="btn btn-primary-outline">Primary Outline</a>
  <a class="btn btn-secondary">Secondary</a>
  <a class="btn btn-secondary-outline">Secondary Outline</a>
  <a class="btn btn-accent">Accent</a>
  <a class="btn btn-accent-outline">Accent Outline</a> #}
  {# <div class="first">
    {% block first %}{% endblock %}
  </div> #}

</div>
