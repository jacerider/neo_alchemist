<?php

/**
 * @file
 * Install, update, and uninstall functions for Neo Alchemist.
 *
 * @ingroup neo_alchemist
 */

/**
 * Implements hook_requirements().
 *
 * Reports component placements whose component no longer exists. Nothing else
 * surfaces this: the tree stores the component id as a plain string, and a
 * missing one is skipped at render, so the page returns 200 with a hole in it
 * and writes nothing anywhere. Without this the only way to notice is to look
 * at the page and already know what used to be there.
 */
function neo_alchemist_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }
  $dangling = \Drupal::service('neo_alchemist.dangling_component_data')->scan();
  if (!$dangling) {
    return [];
  }

  $items = [];
  foreach ($dangling as $componentId => $info) {
    $items[] = t('%component — @count placement(s)', [
      '%component' => $componentId,
      '@count' => $info['count'],
    ]);
  }

  return [
    'neo_alchemist_dangling_components' => [
      'title' => t('Neo Alchemist component placements'),
      'value' => t('@count placement(s) reference a component that does not exist', [
        '@count' => array_sum(array_column($dangling, 'count')),
      ]),
      'description' => [
        'intro' => [
          '#markup' => t('These placements render nothing and report no error. Run <code>drush neo:alchemist:integrity</code> to see where they are, <code>drush neo:alchemist:rename OLD NEW</code> if a component was renamed, or <code>drush neo:alchemist:integrity --detach</code> to remove them.'),
        ],
        'list' => [
          '#theme' => 'item_list',
          '#items' => $items,
        ],
      ],
      'severity' => REQUIREMENT_WARNING,
    ],
  ];
}

use Drupal\Core\Entity\Sql\DefaultTableMapping;
use Drupal\Core\Entity\Sql\SqlEntityStorageInterface;
use Drupal\neo_alchemist\Entity\ComponentFieldConfig;
use Drupal\neo_alchemist\Plugin\DataType\ComponentTreeStructure;
use Drupal\neo_alchemist\Plugin\Field\FieldType\ComponentTreeItem;
use Drupal\Component\Utility\NestedArray;

/**
 * Resave all components to support shape to ref changes.
 */
function neo_alchemist_update_11001() {
  /** @var \Drupal\neo_alchemist\ComponentInterface[] $components */
  $components = \Drupal::entityTypeManager()->getStorage('neo_component')->loadMultiple();
  foreach ($components as $component) {
    $component->save();
  }
}

/**
 * Migrate the entity query "continue" flag to the standard processing mode.
 *
 * The bespoke "continue" setting on the entity_query/entity_filter/views value
 * providers is replaced by the configurable processing mode. "continue: true"
 * maps to "stop_when_found"; "continue: false" is the new default ("block"), so
 * the key is simply removed.
 */
function neo_alchemist_update_11002() {
  $queryProviders = ['entity_query', 'entity_filter', 'views'];
  $migrate = function (array &$data) use (&$migrate, $queryProviders) {
    foreach ($data as &$value) {
      if (!is_array($value)) {
        continue;
      }
      // A provider instance looks like ['id' => X, 'settings' => [...]].
      if (isset($value['id'], $value['settings'])
        && is_array($value['settings'])
        && in_array($value['id'], $queryProviders, TRUE)
        && array_key_exists('continue', $value['settings'])
      ) {
        if (!empty($value['settings']['continue'])) {
          $value['settings']['processing_mode'] = 'block';
        }
        unset($value['settings']['continue']);
      }
      $migrate($value);
    }
  };
  foreach (\Drupal::configFactory()->listAll('neo_alchemist.neo_component.') as $name) {
    $config = \Drupal::configFactory()->getEditable($name);
    $data = $config->getRawData();
    $migrate($data);
    $config->setData($data)->save();
  }
}

/**
 * Block on empty where a prop's examples are editor scaffolding.
 *
 * GetDefaultValue() no longer lets a producer that came up empty destroy the
 * value threaded into it: the search moves on carrying the schema example the
 * pipeline seeded, so attaching an Entity Field provider to a prop no longer
 * silently blanks it on entities whose source field happens to be empty.
 *
 * That is right for a prop whose example is the component author's default —
 * a label, a heading, a subtitle. It is wrong for a prop whose examples are
 * editor scaffolding: placeholder cards, placehold.co images, invented menu
 * links and breadcrumb trails that exist to make the preview legible and must
 * never reach a visitor. Those props say "nothing IS the answer" with the
 * "Always stop (block if empty)" mode, which is now also the default for the
 * producers that fill them (menu, taxonomy_menu, taxonomy_children,
 * entity_reference and breadcrumb, joining entity_query, entity_filter and
 * views). Existing components store their mode explicitly, so this migrates
 * them and keeps rendering exactly as it was.
 *
 * Deliberately conservative — a prop is only rewritten when all of:
 * - Its `ref` is one whose examples are scaffolding rather than a default.
 * - The plugins sit on the prop's own top-level shape. Nested shapes
 *   (`heading~subtitle`, a provider's per-child `shape_fields`) are usually
 *   scalars, where keeping the example is the point of the change.
 * - No `fallback` plugin (the configured Default Value) is enabled on it —
 *   blocking claims the value and would skip the default, replacing one silent
 *   blanking with another.
 * - Only the LAST producer in the pipeline is touched, so a deliberate chain
 *   (entity_reference falling through to entity_query) keeps working.
 * - Every plugin id on the prop resolves. An unknown one means a disabled
 *   module and an unknowable order, so the prop is left alone.
 */
function neo_alchemist_update_11003() {
  $definitions = \Drupal::service('plugin.manager.neo_component_value')->getDefinitions();
  // Refs whose schema examples are scaffolding, not a usable default.
  $scaffolding = ['array', 'menu', 'breadcrumb', 'image', 'video', 'media', 'markup'];
  $changed = [];

  foreach (\Drupal::configFactory()->listAll('neo_alchemist.neo_component.') as $name) {
    $config = \Drupal::configFactory()->getEditable($name);
    $data = $config->getRawData();
    $dirty = FALSE;

    foreach ($data['settings']['props'] ?? [] as $propId => $prop) {
      if (!in_array($prop['ref'] ?? '', $scaffolding, TRUE)) {
        continue;
      }
      $plugins = $prop['plugins'][$propId] ?? NULL;
      if (!is_array($plugins) || !$plugins) {
        continue;
      }

      $groups = [];
      foreach (array_keys($plugins) as $pluginId) {
        if (!isset($definitions[$pluginId]['group'])) {
          // Unresolvable plugin: the pipeline order cannot be trusted.
          continue 2;
        }
        $groups[$pluginId] = $definitions[$pluginId]['group'];
      }
      if (in_array('fallback', $groups, TRUE)) {
        continue;
      }
      $producers = array_keys(array_filter($groups, function ($group) {
        return $group === 'providers';
      }));
      if (!$producers) {
        continue;
      }

      $last = end($producers);
      $mode = $plugins[$last]['settings']['processing_mode'] ?? 'stop_when_found';
      if ($mode !== 'stop_when_found') {
        continue;
      }
      $data['settings']['props'][$propId]['plugins'][$propId][$last]['settings']['processing_mode'] = 'block';
      $changed[] = $data['id'] . ' :: ' . $propId . ' (' . $last . ')';
      $dirty = TRUE;
    }

    if ($dirty) {
      $config->setData($data)->save();
    }
  }

  // Scalar props are deliberately not migrated: for a label or a heading the
  // example IS the component author's default and showing it is the point of
  // the change, but for a prop carrying entity data ("Industry", "Client") the
  // example is invented content that would now render as fact. Only a person
  // can tell those apart, so say so rather than guess.
  $review = (string) t('Review any string, heading or markup prop bound to an entity field: it now falls back to the component\'s example when that field is empty. Where the example is invented data rather than a default label, set its provider to "Always stop (block if empty)".');

  if (!$changed) {
    return (string) t('No component props needed migrating. @review', ['@review' => $review]);
  }
  return (string) t('Set "Always stop (block if empty)" on @count component prop(s), so their placeholder examples cannot reach a visitor: @list. @review', [
    '@count' => count($changed),
    '@list' => implode(', ', $changed),
    '@review' => $review,
  ]);
}

/**
 * Finish the block-on-empty backfill for components in the entity group.
 *
 * Neo_alchemist_update_11003() only ever reached props whose `ref` was one of a
 * fixed scaffolding list, and only the plugins sitting on the prop's OWN
 * top-level shape. It deliberately left scalar refs alone, on the grounds that
 * a string or heading example is usually the component author's default rather
 * than invented content.
 *
 * That reasoning does not hold for a component in the **entity** group. Those
 * components exist to render one entity's fields, so their examples are always
 * invented — "Example string", "Example link", a placeholder video id — and a
 * provider that came up empty must render nothing rather than fall back to
 * them. This finishes the job for that group, and reaches the two places 11003
 * structurally could not:
 * - nested shape ids (`heading~title`), which is where a sub-prop bound to an
 *   entity field actually stores its provider;
 * - a provider's per-child `shape_fields` plugin lists, which
 *   enableChildShapePlugin() hands to the child shape at render time.
 *
 * The guardrails from 11003 are kept, because each of them exists to stop this
 * migration replacing one silent blanking with another:
 * - Only the LAST producer on a shape is touched, so a deliberate chain keeps
 *   working. `entity` falling through to `media` is the live case: blocking
 *   `entity` would claim the value and `media` would never run.
 * - A shape carrying a `fallback` plugin (the configured Default Value) is left
 *   alone — blocking claims the value and the fallback loop never runs.
 * - An explicit `continue` is left alone, as is a mode-less `event` — the one
 *   provider that defaulted to continue when this hook shipped. That list is
 *   era-frozen on purpose: a migration's decisions must not drift when a
 *   plugin's shipped default changes later (media moved to continue after this
 *   hook had already run in production, and blocking a last-producer media on
 *   entity-group components is exactly the outcome this migration produced).
 * - An unresolvable plugin id means a disabled module and an unknowable
 *   pipeline order, so the whole shape is skipped.
 *
 * The mode is written explicitly even where it matches the plugin's PHP
 * default. An unset key is a live reference to processingModeDefault(), so a
 * future change to that constant would move these sites a second time with
 * nothing in config to show for it; and an explicit key is what makes the
 * change visible in `git diff config/`.
 *
 * NOTE for config-managed sites: a `drush cim` after this runs will revert it.
 * Run `drush updb` against a copy of the production database, `drush cex`, and
 * review and commit the diff — then deploy normally.
 */
function neo_alchemist_update_11004() {
  $definitions = \Drupal::service('plugin.manager.neo_component_value')->getDefinitions();
  $changed = [];
  $skipped = [];

  foreach (\Drupal::configFactory()->listAll('neo_alchemist.neo_component.') as $name) {
    $config = \Drupal::configFactory()->getEditable($name);
    $data = $config->getRawData();
    // Component::$group defaults to 'general' when the key was never written.
    if (($data['group'] ?? 'general') !== 'entity') {
      continue;
    }
    $componentId = $data['id'] ?? $name;
    $writes = [];

    foreach ($data['settings']['props'] ?? [] as $propId => $prop) {
      // $shapeId is the prop's own id OR a nested child shape
      // ('heading~title').
      foreach ($prop['plugins'] ?? [] as $shapeId => $instances) {
        if (!is_array($instances) || !$instances) {
          continue;
        }
        _neo_alchemist_processing_mode_visit(
          $instances,
          ['settings', 'props', $propId, 'plugins', $shapeId],
          $definitions,
          $componentId . ' :: ' . $shapeId,
          $writes,
          $skipped
        );
      }
    }

    // Collected as explicit paths and applied here rather than mutated in
    // place: a recursive walk by reference is exactly where silent
    // reference-carryover bugs live, and this is production data.
    foreach ($writes as $write) {
      NestedArray::setValue($data, $write['path'], $write['value'], TRUE);
      $changed[] = $write['label'];
    }
    if ($writes) {
      $config->setData($data)->save();
    }
  }

  if (!$changed) {
    return (string) t('No entity-group component props needed migrating.');
  }
  $message = (string) t('Set "Always stop (block if empty)" on @count entity-group component prop(s): @list.', [
    '@count' => count($changed),
    '@list' => implode(', ', $changed),
  ]);
  if ($skipped) {
    // Named rather than counted: every skip is a prop a person may still need
    // to look at, and the reason is what tells them whether to.
    $message .= ' ' . (string) t('Left alone on purpose: @list.', [
      '@list' => implode('; ', $skipped),
    ]);
  }
  return $message;
}

/**
 * Queue the processing-mode rewrites for one shape's plugin list.
 *
 * Handles all three nesting axes: the shape's own plugins, the heading
 * plugin's per-sub-prop modes, and a provider's `shape_fields` recursion.
 *
 * @param array $instances
 *   The plugin instances, keyed by plugin id.
 * @param array $base
 *   The config key path of $instances.
 * @param array $definitions
 *   The neo_component_value plugin definitions.
 * @param string $label
 *   Human-readable location, for the update's summary.
 * @param array $writes
 *   Collected rewrites, each ['path' => [], 'value' => mixed, 'label' => ''].
 * @param array $skipped
 *   Collected skip messages.
 */
function _neo_alchemist_processing_mode_visit(array $instances, array $base, array $definitions, string $label, array &$writes, array &$skipped): void {
  // `shape_fields` instances carry a status flag, and a disabled one is never
  // handed to the child shape — so it is not in the pipeline and cannot be the
  // last producer. Top-level instances have no such key and are always live.
  $enabled = [];
  foreach ($instances as $pluginId => $instance) {
    if (!is_array($instance) || (array_key_exists('status', $instance) && empty($instance['status']))) {
      continue;
    }
    $enabled[$pluginId] = $instance;
  }

  _neo_alchemist_processing_mode_claim($enabled, $base, $definitions, $label, $writes, $skipped);

  foreach ($enabled as $pluginId => $instance) {
    $settings = $instance['settings'] ?? [];
    if (!is_array($settings)) {
      continue;
    }
    $settingsPath = array_merge($base, [$pluginId, 'settings']);
    $instanceLabel = $label . ' (' . $pluginId . ')';
    if ($pluginId === 'heading') {
      _neo_alchemist_processing_mode_heading($settings, $settingsPath, $instanceLabel, $writes);
    }
    _neo_alchemist_processing_mode_children($settings, $settingsPath, $definitions, $instanceLabel, $writes, $skipped);
  }
}

/**
 * Walk a provider's per-child `shape_fields` configuration.
 *
 * @see \Drupal\neo_alchemist\ChildrenMatch\ChildrenMatchMapper
 */
function _neo_alchemist_processing_mode_children(array $settings, array $base, array $definitions, string $label, array &$writes, array &$skipped): void {
  foreach ($settings['shape_fields'] ?? [] as $childName => $child) {
    if (!is_array($child)) {
      continue;
    }
    $childPath = array_merge($base, ['shape_fields', $childName]);
    $childLabel = $label . ' → ' . $childName;
    if (!empty($child['plugins']) && is_array($child['plugins'])) {
      _neo_alchemist_processing_mode_visit($child['plugins'], array_merge($childPath, ['plugins']), $definitions, $childLabel, $writes, $skipped);
    }
    // `shape_fields` nests directly under the child, as well as under each of
    // the child's own plugins (handled by the visit above).
    _neo_alchemist_processing_mode_children($child, $childPath, $definitions, $childLabel, $writes, $skipped);
  }
}

/**
 * Queue "block" on the one plugin whose emptiness decides the prop.
 */
function _neo_alchemist_processing_mode_claim(array $instances, array $base, array $definitions, string $label, array &$writes, array &$skipped): void {
  if (!$instances) {
    return;
  }
  $groups = [];
  foreach (array_keys($instances) as $pluginId) {
    if (!isset($definitions[$pluginId]['group'])) {
      $skipped[] = $label . ' (unknown plugin "' . $pluginId . '")';
      return;
    }
    $groups[$pluginId] = $definitions[$pluginId]['group'];
  }
  if (in_array('fallback', $groups, TRUE)) {
    $skipped[] = $label . ' (a Default Value plugin is enabled)';
    return;
  }
  // Within a group the pipeline runs plugins in saved config key order, so the
  // last `providers` entry is the one still holding the value when the search
  // ends — and the only one whose mode decides whether the example survives.
  // @see \Drupal\neo_alchemist\Shape\ComponentShapePluginBase::getValueCollection()
  $producers = array_keys($groups, 'providers', TRUE);
  if (!$producers) {
    return;
  }
  $last = end($producers);
  if (!_neo_alchemist_processing_mode_capable($definitions, $last)) {
    return;
  }
  // The STORED value, never the effective one: that is what makes this hook
  // idempotent and what stops it overruling a choice someone made by hand.
  $stored = $instances[$last]['settings']['processing_mode'] ?? NULL;
  if ($stored === 'block') {
    return;
  }
  if ($stored === 'continue') {
    $skipped[] = $label . ' ("' . $last . '" is explicitly set to continue)';
    return;
  }
  // Era-frozen, not reflected from the live class: this migration's decisions
  // must not drift when a plugin's shipped default changes later. At the time
  // this hook shipped, `event` was the only provider defaulting to continue —
  // and `media` defaulting to continue TODAY must not exempt it here, because
  // "block the last producer" (media included, on entity-group components) is
  // exactly the outcome this migration produced on the sites it has already
  // run against.
  if ($stored === NULL && $last === 'event') {
    $skipped[] = $label . ' ("' . $last . '" defaults to continue)';
    return;
  }
  $writes[] = [
    'path' => array_merge($base, [$last, 'settings', 'processing_mode']),
    'value' => 'block',
    'label' => $label . ' (' . $last . ')',
  ];
}

/**
 * Queue "render nothing" on heading sub-props bound to an entity field.
 *
 * Mirrors HeadingValue::isBlockedEmptyField() exactly. The mode is only ever
 * read for a sub-prop with a field binding and no higher-precedence source
 * above it, so writing it anywhere else would be config that lies about what
 * runs. This is independent of the claim rules above: the heading's
 * per-sub-prop mode acts through the child shape's empty option, not by
 * claiming the value.
 */
function _neo_alchemist_processing_mode_heading(array $settings, array $base, string $label, array &$writes): void {
  foreach (['supertitle', 'title', 'subtitle'] as $key) {
    if (empty($settings["{$key}_field"])) {
      continue;
    }
    if (!empty($settings["{$key}_page"]) || !empty($settings["{$key}_entity"])) {
      continue;
    }
    if (($settings["{$key}_field_mode"] ?? 'stop_when_found') === 'block') {
      continue;
    }
    $writes[] = [
      'path' => array_merge($base, ["{$key}_field_mode"]),
      'value' => 'block',
      'label' => $label . ' → ' . $key,
    ];
  }
}

/**
 * Whether a plugin exposes a processing mode at all.
 *
 * Tested against the interface rather than a list of plugin ids, so a plugin
 * that adopts it later — in this module or a contrib one — is covered without
 * anyone remembering to update a constant here.
 */
function _neo_alchemist_processing_mode_capable(array $definitions, string $pluginId): bool {
  $class = $definitions[$pluginId]['class'] ?? NULL;
  return is_string($class)
    && class_exists($class)
    && is_subclass_of($class, 'Drupal\neo_alchemist\Value\ComponentValueProcessingModeInterface');
}

/**
 * Purge the default-layout snapshots locked component tree fields left behind.
 *
 * A locked field (allow_custom: FALSE, no custom regions) renders its default
 * layout and ignores the stored row entirely — NeoComponentTreeList::setValue()
 * discards it on load. Until the accompanying ::preSave() fix, though, the
 * constructor's default seed was written verbatim into every entity's row on
 * insert. Those rows never rendered, but anything reading the column directly
 * saw them: the component usage report counted them as content usage, and kept
 * counting components the default layout had long since dropped.
 *
 * Only rows with a POPULATED root are purged. A hybrid storage subset always
 * has an empty root (::extractHybridStorageValue() seeds [ROOT_UUID => []]), so
 * content authored while a field was hybrid — dormant but recoverable if the
 * region is re-flagged — is left untouched.
 *
 * Every purged row is archived to state first, so this is reversible.
 *
 * @see \Drupal\neo_alchemist\Plugin\Field\NeoComponentTreeList::preSave()
 */
function neo_alchemist_update_11005() {
  $rootUuid = ComponentTreeStructure::ROOT_UUID;
  $entityTypeManager = \Drupal::entityTypeManager();
  $entityFieldManager = \Drupal::service('entity_field.manager');
  $database = \Drupal::database();
  $archive = [];
  $purged = [];
  $skipped = 0;

  foreach ($entityTypeManager->getStorage('field_config')->loadMultiple() as $field) {
    if ($field->getType() !== 'neo_component_tree') {
      continue;
    }
    // The mode accessors live on ComponentFieldConfig; a field_config loaded
    // from storage is a plain FieldConfig.
    $componentField = $field instanceof
    ComponentFieldConfig ? $field
      : new ComponentFieldConfig($field->toArray(), 'field_config');
    if ($componentField->allowCustom() || $componentField->isHybrid()) {
      continue;
    }

    $entityTypeId = $field->getTargetEntityTypeId();
    $bundle = $field->getTargetBundle();
    $fieldName = $field->getName();
    $storage = $entityTypeManager->getStorage($entityTypeId);
    if (!$storage instanceof SqlEntityStorageInterface) {
      continue;
    }
    $storageDefinition = $entityFieldManager->getFieldStorageDefinitions($entityTypeId)[$fieldName] ?? NULL;
    if (!$storageDefinition) {
      continue;
    }
    $tableMapping = $storage->getTableMapping();
    $column = $tableMapping->getFieldColumnName($storageDefinition, 'tree');
    $tables = [$tableMapping->getFieldTableName($fieldName)];
    if ($tableMapping instanceof DefaultTableMapping) {
      $tables[] = $tableMapping->getDedicatedRevisionTableName($storageDefinition);
    }

    foreach (array_unique(array_filter($tables)) as $table) {
      if (!$database->schema()->tableExists($table) || !$database->schema()->fieldExists($table, 'bundle')) {
        continue;
      }
      $rows = $database->select($table, 't')
        ->fields('t')
        ->condition('t.bundle', $bundle)
        ->execute()
        ->fetchAll(\PDO::FETCH_ASSOC);

      foreach ($rows as $row) {
        $tree = !empty($row[$column]) ? json_decode($row[$column], TRUE) : NULL;
        // An empty root means a hybrid subset (or nothing at all) — keep it.
        if (!is_array($tree) || empty($tree[$rootUuid])) {
          $skipped++;
          continue;
        }
        $archive[] = ['table' => $table, 'row' => $row];
        $delete = $database->delete($table)
          ->condition('entity_id', $row['entity_id'])
          ->condition('langcode', $row['langcode'])
          ->condition('delta', $row['delta']);
        if (array_key_exists('deleted', $row)) {
          $delete->condition('deleted', $row['deleted']);
        }
        if (array_key_exists('revision_id', $row)) {
          $delete->condition('revision_id', $row['revision_id']);
        }
        $delete->execute();
        $key = $entityTypeId . '.' . $bundle . '.' . $fieldName;
        $purged[$key] = ($purged[$key] ?? 0) + 1;
      }
    }
  }

  if (!$archive) {
    return (string) t('No locked-field default-layout snapshots found. Skipped @skipped row(s) that were not snapshots.', [
      '@skipped' => $skipped,
    ]);
  }

  \Drupal::state()->set('neo_alchemist.purged_locked_rows_11005', $archive);

  $parts = [];
  foreach ($purged as $key => $count) {
    $parts[] = $key . ' (' . $count . ')';
  }
  return (string) t('Purged @count default-layout snapshot row(s) from locked component tree fields: @list. Left @skipped row(s) untouched. The purged rows are archived in state under "neo_alchemist.purged_locked_rows_11005"; delete that key once the result looks right.', [
    '@count' => count($archive),
    '@list' => implode(', ', $parts),
    '@skipped' => $skipped,
  ]);
}

/**
 * Report component trees damaged by the pre-fix destructive reorder.
 *
 * Reordering a section used to rebuild it from the list of UUIDs the caller
 * passed and discard everything else, and the callers built that list from a
 * presentation helper that skips any instance whose neo_component config no
 * longer loads. So a single "move up" or "move down" on a section containing a
 * broken component deleted that component's tuple while leaving its subtree
 * section and every descendant's prop values behind — a dangling subtree, which
 * ComponentTreeStructureConstraintValidator rejects and the hydrated tree
 * silently discards at render, plus prop entries nothing can attribute.
 *
 * The reorder is a permutation now and cannot do this again, but rows damaged
 * before the fix are already in the database and nothing surfaces them: the
 * page still returns 200, just without that component.
 *
 * This REPORTS and does not rewrite. The damage is historical, the affected
 * rows are content, and the recoverable choice is a maintainer's to make with
 * the scope in front of them.
 *
 * On the repair: `drush neo:alchemist:integrity` covers the other half of this
 * damage — placements whose component no longer exists — and `--detach` removes
 * them. It does NOT see the stranded sections counted here, because every
 * component id inside them still resolves. There is deliberately no command
 * for these: a stranded subtree still holds the creator's authored props, so
 * whether to re-place that content or discard it is not a decision to automate.
 * Report the rows, then edit them.
 *
 * Batched: this walks entity content tables, including revisions, so a large
 * site would otherwise exhaust memory or time in a single pass.
 *
 * @see \Drupal\neo_alchemist\Plugin\DataType\ComponentTreeStructure::reorderComponents()
 */
function neo_alchemist_update_11006(&$sandbox) {
  $rootUuid = ComponentTreeStructure::ROOT_UUID;
  $entityTypeManager = \Drupal::entityTypeManager();
  $entityFieldManager = \Drupal::service('entity_field.manager');
  $database = \Drupal::database();
  $schema = $database->schema();

  if (!isset($sandbox['targets'])) {
    // One pass over the field map to work out what there is to read, then one
    // target per table so each pass is bounded by a single table's row count.
    $sandbox['targets'] = [];
    $sandbox['scanned'] = 0;
    $sandbox['damaged'] = [];
    foreach ($entityFieldManager->getFieldMapByFieldType('neo_component_tree') as $entityTypeId => $fields) {
      $storage = $entityTypeManager->getStorage($entityTypeId);
      if (!$storage instanceof SqlEntityStorageInterface) {
        continue;
      }
      $tableMapping = $storage->getTableMapping();
      $definitions = $entityFieldManager->getFieldStorageDefinitions($entityTypeId);

      foreach (array_keys($fields) as $fieldName) {
        if (!isset($definitions[$fieldName])) {
          continue;
        }
        $treeColumn = $tableMapping->getFieldColumnName($definitions[$fieldName], 'tree');
        $propsColumn = $tableMapping->getFieldColumnName($definitions[$fieldName], 'props');
        $tables = [$tableMapping->getFieldTableName($fieldName)];
        if ($tableMapping instanceof DefaultTableMapping) {
          $tables[] = $tableMapping->getDedicatedRevisionTableName($definitions[$fieldName]);
        }
        foreach (array_unique(array_filter($tables)) as $table) {
          if (!$schema->tableExists($table) || !$schema->fieldExists($table, $treeColumn)) {
            continue;
          }
          $idColumn = $schema->fieldExists($table, 'entity_id')
            ? 'entity_id'
            : $entityTypeManager->getDefinition($entityTypeId)->getKey('id');
          $sandbox['targets'][] = [
            'label' => $entityTypeId . '.' . $fieldName,
            'table' => $table,
            'tree' => $treeColumn,
            'props' => $propsColumn,
            'id' => $idColumn,
          ];
        }
      }
    }
    $sandbox['total'] = count($sandbox['targets']);
    $sandbox['done'] = 0;
    $sandbox['offset'] = 0;
  }

  if (!$sandbox['targets']) {
    $sandbox['#finished'] = 1;
    return (string) t('Scanned @count stored component tree(s); none carry a dangling subtree or an unattributable prop entry.', [
      '@count' => $sandbox['scanned'],
    ]);
  }

  $target = $sandbox['targets'][0];
  // Only the three columns the scan reads, and a bounded slice of them.
  $records = $database->select($target['table'], 't')
    ->fields('t', [$target['id'], $target['tree'], $target['props']])
    ->orderBy('t.' . $target['id'])
    ->range($sandbox['offset'], 200)
    ->execute()
    ->fetchAll(\PDO::FETCH_ASSOC);

  foreach ($records as $record) {
    $tree = !empty($record[$target['tree']]) ? json_decode($record[$target['tree']], TRUE) : NULL;
    if (!is_array($tree) || !$tree) {
      continue;
    }
    $sandbox['scanned']++;
    // A hybrid subset's anchor owners are section keys that are not instances
    // of the subset. Recognisable by the empty root, and deliberately not
    // counted: they are dangling by design.
    $subset = ComponentTreeStructure::isStorageSubset($tree);
    $placed = array_flip(ComponentTreeStructure::collectInstanceUuids($tree));

    $dangling = [];
    if (!$subset) {
      foreach (array_keys($tree) as $sectionKey) {
        if ($sectionKey !== $rootUuid && !isset($placed[$sectionKey])) {
          $dangling[] = $sectionKey;
        }
      }
    }

    $props = !empty($record[$target['props']]) ? json_decode($record[$target['props']], TRUE) : NULL;
    $orphanProps = is_array($props) ? array_keys(array_diff_key($props, $placed)) : [];

    if ($dangling || $orphanProps) {
      $sandbox['damaged'][$target['label']][] = sprintf(
        '%s %s (%d dangling subtree(s), %d unattributable prop entr(ies))',
        $target['table'],
        $record[$target['id']] ?? '?',
        count($dangling),
        count($orphanProps),
      );
    }
  }

  if (count($records) < 200) {
    array_shift($sandbox['targets']);
    $sandbox['offset'] = 0;
    $sandbox['done']++;
  }
  else {
    $sandbox['offset'] += 200;
  }

  $sandbox['#finished'] = $sandbox['targets'] ? $sandbox['done'] / max(1, $sandbox['total']) : 1;
  if ($sandbox['targets']) {
    return NULL;
  }

  if (!$sandbox['damaged']) {
    return (string) t('Scanned @count stored component tree(s); none carry a dangling subtree or an unattributable prop entry.', [
      '@count' => $sandbox['scanned'],
    ]);
  }

  $parts = [];
  foreach ($sandbox['damaged'] as $key => $rows) {
    $parts[] = $key . ': ' . implode('; ', $rows);
  }
  return (string) t('Scanned @scanned stored component tree(s) and found damage in @rows row(s), left untouched for review: @list. These are trees a pre-fix reorder deleted an instance from without removing what sat underneath it. Each stranded subtree still holds its authored prop values, so decide per row whether to re-place that content or discard it — nothing here rewrites content, and no command does it for you.', [
    '@scanned' => $sandbox['scanned'],
    '@rows' => array_sum(array_map('count', $sandbox['damaged'])),
    '@list' => implode(' | ', $parts),
  ]);
}

/**
 * Give existing read_time providers an explicit "stop when found" mode.
 *
 * `read_time` gained ComponentValueProcessingModeInterface. Before that it
 * sourced a value but could never claim it, so a later provider on the same
 * prop silently overwrote what the site builder had configured. Its mode now
 * defaults to stop_when_found, and because read_time always produces a
 * non-empty placeholder, that means it claims and the search stops — the
 * defect is fixed.
 *
 * That new behaviour arrives the moment the code ships, whether or not this
 * hook runs: an unset `processing_mode` key resolves through
 * ComponentValueProcessingModeTrait::getProcessingMode() to the plugin default.
 * The hook exists to make the change VISIBLE rather than silent — it writes the
 * mode into stored config so `git diff config/` shows it, exactly as update
 * 11004 reasoned about an unset key being a live reference to
 * processingModeDefault().
 *
 * Only read_time is touched, and only where the key is absent: a mode a site
 * builder set by hand (block, continue) is left alone, which also makes the
 * hook idempotent. read_time is not an inline plugin, so it never lives inside
 * a provider's `shape_fields` list — only on a prop's own shape or an expanded
 * child shape id (`heading~title`), both of which sit directly under
 * `settings.props.<prop>.plugins.<shape id>` and are walked here.
 */
function neo_alchemist_update_11007() {
  $changed = [];

  foreach (\Drupal::configFactory()->listAll('neo_alchemist.neo_component.') as $name) {
    $config = \Drupal::configFactory()->getEditable($name);
    $data = $config->getRawData();
    $dirty = FALSE;

    foreach ($data['settings']['props'] ?? [] as $propId => $prop) {
      // $shapeId is the prop's own id OR an expanded child shape id.
      foreach ($prop['plugins'] ?? [] as $shapeId => $instances) {
        if (!is_array($instances) || !isset($instances['read_time']) || !is_array($instances['read_time'])) {
          continue;
        }
        $settings = $instances['read_time']['settings'] ?? [];
        if (is_array($settings) && array_key_exists('processing_mode', $settings)) {
          continue;
        }
        $data['settings']['props'][$propId]['plugins'][$shapeId]['read_time']['settings']['processing_mode'] = 'stop_when_found';
        $changed[] = ($data['id'] ?? $name) . ' :: ' . $shapeId;
        $dirty = TRUE;
      }
    }

    if ($dirty) {
      $config->setData($data)->save();
    }
  }

  if (!$changed) {
    return (string) t('No component read_time providers needed a processing mode written.');
  }
  return (string) t('Wrote an explicit "Use its value and stop" processing mode onto @count read_time provider(s), pinning in config the behaviour they now take by default so a later provider can no longer overwrite them: @list.', [
    '@count' => count($changed),
    '@list' => implode(', ', $changed),
  ]);
}

/**
 * Re-key in-flight whole-tree drafts into the shared draft store's key space.
 *
 * The collaborative layout draft used to be keyed
 * "neo_alchemist.<entity id>.<field name>" in state by a key function on the
 * field item. That function is gone: the draft now lives behind SharedDraftStore
 * under its own "neo_alchemist_draft." prefix, and the key derivation folds in
 * the entity type and langcode the old key omitted — fixing the collision where
 * drafts collided across entity types that share an id and translations of one
 * entity shared a single draft.
 *
 * Splitting the key space would orphan every draft already sitting in state:
 * unpublished editor work on a live site, not scratch. So this walks the state
 * keyvalue collection and moves each old whole-tree draft to its new key,
 * seeding the version and last-modified stamp a pre-metadata record lacks
 * (SharedDraftStore::seedMigratedRecord()) so it comes across well-formed. The
 * re-key goes THROUGH the store rather than reconstructing the private key, so
 * the entity type and langcode are folded in by one derivation for both the
 * live path and this migration — and because the entity type is not in the old
 * key, the entity is resolved by matching the field name back to the entity
 * types that declare it and loading the id against each.
 *
 * Preview values are NOT migrated: they are cache-backed disposable scratch
 * (SdcPreviewStore), never in state, so this never sees them — and losing them
 * on update is correct, not data loss.
 *
 * Conservative by construction:
 * - Only an exact three-part "neo_alchemist.<id>.<field>" key whose field is a
 *   real neo_component_tree field is a draft. Other neo_alchemist state — a
 *   filter's preview entity (five parts), an archived purge (two) — is left
 *   alone, and the new "neo_alchemist_draft." prefix does not match, so a
 *   re-run is a no-op.
 * - A draft whose entity no longer exists is left under its old key, not
 *   dropped: the content survives for a maintainer even though the entity that
 *   would render it is gone.
 * - A draft whose entity type cannot be told apart (the very collision the new
 *   key fixes, but unresolvable after the fact — two entity types with a
 *   like-named field and the same id) is left for a maintainer.
 * - A draft is never written over an entity that already carries a newer draft.
 *
 * @see \Drupal\neo_alchemist\EditorState\SharedDraftStore::seedMigratedRecord()
 */
function neo_alchemist_update_11008() {
  $entityTypeManager = \Drupal::entityTypeManager();
  $entityFieldManager = \Drupal::service('entity_field.manager');
  /** @var \Drupal\neo_alchemist\EditorState\SharedDraftStore $store */
  $store = \Drupal::service('neo_alchemist.shared_draft_store');
  $state = \Drupal::state();

  // field name => [entity type, ...] for every neo_component_tree field. The
  // old draft key carried the entity id and field name but never the entity
  // type, so this reverse index is how a draft is matched back to its entity.
  $fieldTypes = [];
  foreach ($entityFieldManager->getFieldMapByFieldType('neo_component_tree') as $entityTypeId => $fields) {
    foreach (array_keys($fields) as $fieldName) {
      $fieldTypes[$fieldName][] = $entityTypeId;
    }
  }

  $migrated = 0;
  $unresolved = [];
  $ambiguous = [];
  $skipped = [];

  foreach (\Drupal::keyValue('state')->getAll() as $key => $value) {
    // The old whole-tree draft key was exactly
    // "neo_alchemist.<entity id>.<field name>" — three dot-parts, no uuid. A
    // field name carries no dots and a content entity id is an integer, so an
    // exact three-part split parses it unambiguously and skips everything else.
    if (!str_starts_with($key, 'neo_alchemist.') || !is_array($value)) {
      continue;
    }
    $parts = explode('.', $key);
    if (count($parts) !== 3) {
      continue;
    }
    [, $entityId, $fieldName] = $parts;
    if (!isset($fieldTypes[$fieldName])) {
      continue;
    }

    // Resolve the entity the draft belongs to across every entity type that
    // declares a field of this name. More than one may match the same id — the
    // collision the new key fixes but that cannot be undone after the fact.
    $items = [];
    foreach ($fieldTypes[$fieldName] as $entityTypeId) {
      $entity = $entityTypeManager->getStorage($entityTypeId)->load($entityId);
      if (!$entity || !$entity->hasField($fieldName)) {
        continue;
      }
      $list = $entity->get($fieldName);
      // A drafting entity may have no saved field value yet, so append a
      // transient item purely to derive the store key from the live entity.
      $item = $list->first() ?? $list->appendItem();
      if ($item instanceof ComponentTreeItem) {
        $items[$entityTypeId] = $item;
      }
    }

    if (!$items) {
      $unresolved[] = $key;
      continue;
    }
    if (count($items) > 1) {
      $ambiguous[] = $key . ' (' . implode(', ', array_keys($items)) . ')';
      continue;
    }

    $item = reset($items);
    // Never overwrite a newer draft written since the deploy.
    if ($store->has($item)) {
      $skipped[] = $key;
      continue;
    }

    $store->seedMigratedRecord($item, $value);
    $state->delete($key);
    $migrated++;
  }

  $summary = [(string) t('Re-keyed @count in-flight draft(s) into the shared draft store, seeding each with a version and last-modified stamp.', [
    '@count' => $migrated,
  ])];
  if ($unresolved) {
    $summary[] = (string) t('Left @count draft(s) whose entity no longer exists under their old key rather than drop them: @list.', [
      '@count' => count($unresolved),
      '@list' => implode(', ', $unresolved),
    ]);
  }
  if ($ambiguous) {
    $summary[] = (string) t('Left @count draft(s) whose entity type could not be told apart from the old key alone, to resolve by hand: @list.', [
      '@count' => count($ambiguous),
      '@list' => implode(', ', $ambiguous),
    ]);
  }
  if ($skipped) {
    $summary[] = (string) t('Left @count draft(s) whose entity already carries a newer draft: @list.', [
      '@count' => count($skipped),
      '@list' => implode(', ', $skipped),
    ]);
  }
  return implode(' ', $summary);
}
