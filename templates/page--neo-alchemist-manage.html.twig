{#
/**
 * @file
 * Theme override to display a single page.
 *
 * @see template_preprocess_page()
 * @see html.html.twig
 */
#}
{%
  set page_classes = [
    'section',
    'page',
  ]
%}
<div{{ attributes.addClass(page_classes) }}>
  {# <div id="neo-alchemist--messages" class="fixed top-0 right-0 p-4 opacity-0 transition-opacity z-50">
    {{ page.status }}
  </div> #}
  {{ page.status }}
  {{ page.content }}
</div>
