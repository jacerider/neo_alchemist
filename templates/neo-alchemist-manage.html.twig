{#
  scheme--reset: the editor opens both as a page and inside a modal, and
  neo_modal puts every modal's content in the reset scheme. Carrying it here as
  well gives both the same button colours (neo_color's contrast-picked fills)
  instead of the raw brand colour a page outside any scheme falls back to.
#}
<div{% if id %} id="{{ id }}"{% endif %}{% if dev %} data-alchemist-dev{% endif %} class="neo-alchemist-manage scheme--reset fixed flex flex-col top-0 left-0 w-full h-full bg-base-300 z-0 modal:relative" style="--neo-alchemist-floating-gap: 16px;">
  {#
    The band: one dark bar for the whole editor. Leading, the way out and what
    is open — Back, the screen's title and, under it, where the draft stands;
    centred, what builds the page — + Add, Layers and a pill per side panel;
    trailing, the panels' badges, Undo · Redo and the save
    group. The status line and the save group are re-rendered after every
    write (top_status, top_save; see ComponentAjaxHelperTrait), so their boxes
    are rendered whenever the band is, even empty. The leading and trailing
    groups share the room left by the centre equally, which keeps the centre
    centred; headerFit() in components-parent.ts compacts the band when that
    room runs out.
  #}
  {% if top_start or top_center or top_end or top_save or top_title %}
    <div class="neo-alchemist-manage--top relative flex-none flex items-center gap-4 w-full min-h-14 px-3 py-2 bg-base-900 text-base-900-content z-50" data-alchemist-offset-top>
      <div class="neo-alchemist-manage--top-start flex flex-1 basis-0 min-w-0 items-center gap-3">
        {{ top_start.back }}
        {% if top_title %}
          <div class="neo-alchemist-manage--identity min-w-0 max-w-80 shrink-0 flex flex-col justify-center{{ top_start.back ? ' border-l border-base-700 pl-3' }}">
            <div class="neo-alchemist-manage--title truncate text-sm font-semibold leading-tight">{{ top_title }}</div>
            {% if top_status %}
              <div class="neo-alchemist-manage--top-status flex items-center gap-2 mt-0.5 text-xs text-base-900-content/75 whitespace-nowrap">{{ top_status }}</div>
            {% endif %}
          </div>
        {% endif %}
        {{ top_start|without('back') }}
      </div>
      {% if top_center %}
        <div class="neo-alchemist-manage--top-center flex flex-none items-center gap-2">{{ top_center }}</div>
      {% endif %}
      <div class="neo-alchemist-manage--top-trail flex flex-1 basis-0 min-w-0 items-center justify-end gap-3">
        {# Always there: a client may mount a badge into it (the SDC preview's audit). #}
        <div class="neo-alchemist-manage--top-end flex items-center gap-3 empty:hidden">{{ top_end }}</div>
        <div class="neo-alchemist-manage--top-save flex items-center gap-2 empty:hidden">{{ top_save }}</div>
      </div>
    </div>
  {% endif %}

  {#
    The breadcrumb bar: where the selection sits, written by the layout editor
    (titleSet() in components-parent.ts), which unhides it. The band's second
    row, the full width of the editor, so the docks start below it and it
    stays when the inspector is expanded over the canvas — the crumbs are then
    the only way up and down the tree. Always there while that editor is, so
    selecting never shifts anything.
  #}
  <nav class="neo-alchemist--crumbs flex-none bg-base-800 text-base-800-content border-t border-base-0/5 shadow z-40" aria-label="{{ 'Selection'|t }}" hidden data-alchemist-ignore data-alchemist-nodrag>
    <div class="neo-alchemist--crumbs-trail flex items-center gap-1 h-10 overflow-x-auto px-3 text-xs [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"></div>
  </nav>

  {#
    Columns: the canvas, then the right dock (the inspector). The canvas owns
    whatever width the docks leave it, and the preview fits itself to that
    (Fit, component-parent.ts).
  #}
  <div class="neo-alchemist-manage--body flex flex-auto relative overflow-hidden">

  {#
    The left dock holds what belongs to the whole page, one thing at a time:
    Layers, or a side panel another module adds (AlchemistPanelInterface —
    Search & social), each opened by its own header button and shown under
    its own title, never as a tab of Layers. Selection-specific things live in
    the right dock (the inspector).

    Layers is built entirely from the structure data the preview frames
    already report, so the whole tree — including regions that are empty or
    scrolled out of view — is addressable, and reorderable by dragging,
    without hunting on the canvas. A panel's body is its own build(), which
    its client half mounts into on first open (panels.ts); a panel widens the
    dock to its own width. Layers folds to an icon rail (`.is-rail`) when the
    window is narrow and the inspector opens; a panel never does. See
    layersPosition() in components-parent.ts.
  #}
  <aside id="neo-alchemist-layers" class="neo-alchemist--layers flex-none flex flex-col border-r bg-base-0 text-base-0-content" style="display: none;" aria-label="{{ 'Page'|t }}" data-alchemist-ignore data-alchemist-nodrag>
    <div class="neo-alchemist--layers-header flex flex-none items-center justify-between gap-2 border-b px-2 text-sm">
      <span class="neo-alchemist--layers-title px-1 py-2 font-semibold">{{ 'Layers'|t }}</span>
      <button type="button" class="neo-alchemist--layers-close btn btn-xs btn-outline flex-none" title="{{ 'Hide'|t }}">{{ icon('times') }}<span class="sr-only">{{ 'Hide'|t }}</span></button>
    </div>
    <button type="button" class="neo-alchemist--layers-rail btn btn-xs btn-outline m-2" title="{{ 'Show layers'|t }}" hidden>{{ icon('sitemap') }}<span class="sr-only">{{ 'Show layers'|t }}</span></button>
    <div class="neo-alchemist--left-pane flex flex-auto flex-col min-h-0" data-left-pane="layers">
      {# Not a tab stop itself: one row is (a roving tree, layersSelectionSet()). #}
      <div class="neo-alchemist--layers-tree flex-auto overflow-y-auto py-1" role="tree" aria-label="{{ 'Component layers'|t }}"></div>
    </div>
    {% for panel in side_panels %}
      <div class="neo-alchemist--sidepanel neo-alchemist--left-pane flex flex-auto flex-col min-h-0" data-alchemist-sidepanel="{{ panel.id }}" data-left-pane="{{ panel.id }}" data-label="{{ panel.label }}" data-width="{{ panel.width }}" hidden>
        <div class="neo-alchemist--sidepanel-message flex-none border-b px-3 py-2 text-xs bg-warning-50 text-warning-900" role="alert" hidden></div>
        <div class="neo-alchemist--sidepanel-body flex-auto overflow-y-auto">{{ panel.body }}</div>
      </div>
    {% endfor %}
  </aside>

  <div class="neo-alchemist-manage--canvas flex flex-col flex-auto min-w-0 relative overflow-hidden">

    {# The preview area: the scrolling canvas, with the dock floating over it. #}
    <div class="neo-alchemist-manage--preview relative flex flex-auto min-h-0">
    <div class="neo-alchemist-manage--wrapper relative flex-auto flex bg-base-100 overflow-auto [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]" style="visibility: hidden">
      <div class="neo-alchemist-manage--drag flex items-start justify-center cursor-grab">
        {{ iframe_start }}
        {# <div class="flex scale-75 origin-top"> #}
        <div class="neo-alchemist-manage--scale flex">
          {# <div class="flex flex-col gap-4"> #}
          <div class="flex items-start justify-center gap-12 px-16">
            {%
              set wrap_classes = 'neo-alchemist--iframe-wrapper pt-16 pb-28 flex flex-col gap-2'
            %}
            {#
              The header card names the frame; Single mode hides it and most of
              the band above it (component-parent.css), since the size toggle
              already says which frame is shown.
            #}
            {%
              set header_classes = 'neo-alchemist--iframe-header flex items-center gap-2 p-2 bg-base-0 text-base-700 text-xs border rounded'
            %}
            {%
              set label_classes = 'flex items-center gap-2'
            %}
            {%
              set icon_classes = 'p-1 w-6 h-6 text-center rounded bg-base-500 text-base-500-content'
            %}
            {%
              set size_classes = 'neo-alchemist--iframe-size text-xs text-base-400 ml-auto'
            %}
            {%
              set content_classes = 'relative border rounded bg-base-0'
            %}
            <div class="{{ wrap_classes }}" style="width:1538px">
              <div class="{{ header_classes}}">
                <div class="{{ label_classes }}">
                  <div class="{{ icon_classes }}">{{ icon('desktop') }}</div><div>Desktop</div>
                </div>
                <div class="{{ size_classes }}"></div>
              </div>
              <div class="{{ content_classes }}">
                <iframe class="neo-alchemist--iframe w-full" data-size="desktop" src="{{ src_desktop }}" frameborder="0"></iframe>
              </div>
            </div>
            <div class="{{ wrap_classes }}" style="width:770px">
              <div class="{{ header_classes}}">
                <div class="{{ label_classes }}">
                  <div class="{{ icon_classes }}">{{ icon('tablet') }}</div><div>Tablet</div>
                </div>
                <div class="{{ size_classes }}"></div>
              </div>
              <div class="{{ content_classes }}">
                {# data-src, not src: the previews are started one at a time by
                   staggerIframeLoads() in component-parent.ts. #}
                <iframe class="neo-alchemist--iframe w-full" data-size="tablet" data-src="{{ src_tablet }}" frameborder="0"></iframe>
                {# Shown while the canvas waits on this frame; see showSize() in
                   component-parent.ts. #}
                <div class="neo-alchemist--iframe-loading absolute inset-0 items-center justify-center gap-2 bg-base-0/90 text-sm text-base-400">{{ icon('spinner') }}<span>{{ 'Loading preview…'|t }}</span></div>
              </div>
            </div>
            <div class="{{ wrap_classes }}" style="width:440px">
              <div class="{{ header_classes}}">
                <div class="{{ label_classes }}">
                  <div class="{{ icon_classes }}">{{ icon('mobile') }}</div><div>Mobile</div>
                </div>
                <div class="{{ size_classes }}"></div>
              </div>
              <div class="{{ content_classes }}">
                <iframe class="neo-alchemist--iframe w-full" data-size="mobile" data-src="{{ src_mobile }}" frameborder="0"></iframe>
                {# Shown while the canvas waits on this frame; see showSize() in
                   component-parent.ts. #}
                <div class="neo-alchemist--iframe-loading absolute inset-0 items-center justify-center gap-2 bg-base-0/90 text-sm text-base-400">{{ icon('spinner') }}<span>{{ 'Loading preview…'|t }}</span></div>
              </div>
            </div>
          </div>
        </div>
        {{ iframe_end }}
      </div>
    </div>

    {#
      The preview dock: device, zoom and Compare, floating at the bottom of
      the canvas, apart from the band — they change how the page is looked
      at, not the page. It goes when the canvas does (Expand, Form View). The
      frames leave room for it below themselves (pb-28).
    #}
    {% if preview %}
      <div class="neo-alchemist--preview-dock-slot absolute inset-x-0 bottom-6 z-30 flex justify-center pointer-events-none" data-alchemist-ignore data-alchemist-nodrag>
        {{ preview }}
      </div>
    {% endif %}
    </div>

    {% if form and form_position == 'footer' %}
      <div class="neo-alchemist--form-footer border-t border-base-0 z-50 top-0 left-0 right-0 flex justify-center text-xs border border-x-0 bg-base-200">
        {%
          set sizing = 'py-1 px-4 text-base-800 hover:bg-base-100 hover:text-base-950 is-active:bg-base-0 is-active:text-base-950 is-active:font-bold'
        %}
        <a class="neo-alchemist-manage--size-expand neo-alchemist--sizing {{ sizing }}" href="#">{{ icon('arrow-to-top') }} {{ 'Form View'|t }}</a>
        <a class="neo-alchemist-manage--size-split neo-alchemist--sizing {{ sizing }}" href="#">{{ icon('compress') }} {{ 'Split View'|t }}</a>
        <a class="neo-alchemist-manage--size-contract neo-alchemist--sizing {{ sizing }}" href="#">{{ icon('arrow-to-bottom') }} {{ 'Preview View'|t }}</a>
      </div>
      {#
        Scrolls as a whole, which is right for the forms that render here.
        A three-band form (see neo-alchemist-component-form.html.twig) scrolls
        its own fields instead, and component-parent.css switches this box to a
        clipped column when it finds one — keyed off the layout itself, so a
        form without one is untouched.
      #}
      <div class="neo-alchemist-manage--form-wrapper flex-auto overflow-auto bg-base-0">
        {{ form|neo_class('neo-alchemist-manage--form') }}
      </div>
    {% endif %}

  </div>

    {% if form and form_position == 'side' %}
      <div class="neo-alchemist-manage--form-wrapper neo-alchemist--form-side absolute flex flex-col rounded-lg shadow-lg overflow-hidden">
        {% if toolbar or toolbar_title %}
          {#
            The title is dimmed rather than sized up: it names the task once,
            and the component's own name is right below it in the identity row.
            Anything louder competes with that.
          #}
          <div class="flex items-center gap-2 bg-base-950 px-3 py-2">
            {{ toolbar }}
            {% if toolbar_title %}
              <span class="text-xs font-semibold text-base-0/75">{{ toolbar_title }}</span>
            {% endif %}
          </div>
        {% endif %}
        <div class="neo-alchemist-manage--form-scroll bg-base-0 px-4 grow">
          {{ form|neo_class('neo-alchemist-manage--form p-0 pt-4')|neo_class('mt-0', 'inner_attributes') }}
        </div>
      </div>
    {% endif %}

    {#
      The inspector: the selected component's form, docked on the right. In
      the layout editor it opens and closes with the selection and its form is
      loaded into the body (components-parent.ts); opened on its own, the edit
      page renders it with its form.

      Its header is the inspector's band, on base-100: who the
      component is, where it sits and what can be done to it. The top row
      leads with "‹ Parent", which selects the parent the breadcrumb shows
      (or clears the selection, "‹ Page") — the layout editor's only; the edit
      page names its task there instead — then Expand and Close. Under it the
      form's own name (with its "?" help) and summary chips, moved up from the
      form each time it is wired (bindForm() in component-parent.ts), then the
      position ("2 of 3 in List S5", components-parent.ts), then the
      selection's ops: Move up/down as icons, the verbs labelled. The prompt
      asks about unapplied changes in place, with no dialog.
    #}
    {% if dock %}
      <aside class="neo-alchemist--dock flex-none flex flex-col border-l bg-base-0 text-base-0-content z-40"{% if not (form and form_position == 'dock') %} hidden{% endif %} aria-label="{{ 'Inspector'|t }}" data-alchemist-ignore data-alchemist-nodrag>
        <div class="neo-alchemist--dock-header neo-alchemist--dock-band flex-none flex flex-col gap-2 border-b px-4 pt-2 pb-3">
          <div class="flex items-center gap-1 -mx-1">
            {% if dock_close %}
              <button type="button" class="neo-alchemist--dock-parent" hidden>{{ icon('chevron-left') }}<span class="neo-alchemist--dock-parent-label truncate"></span></button>
            {% endif %}
            {%- if toolbar_title -%}
              <span class="neo-alchemist--dock-title truncate px-1 text-xs font-semibold">{{ toolbar_title }}</span>
            {%- endif -%}
            <span class="flex-auto"></span>
            <button type="button" class="neo-alchemist--dock-expand neo-alchemist--dock-band-icon flex-none" title="{{ 'Expand'|t }}" aria-pressed="false">{{ icon('expand') }}<span class="sr-only">{{ 'Expand'|t }}</span></button>
            {% if dock_close %}
              <button type="button" class="neo-alchemist--dock-close neo-alchemist--dock-band-icon flex-none" title="{{ 'Close'|t }}">{{ icon('times') }}<span class="sr-only">{{ 'Close'|t }}</span></button>
            {% endif %}
          </div>
          <div class="neo-alchemist--dock-identity empty:hidden"></div>
          {% if dock_close %}
            <div class="neo-alchemist--dock-position text-xs" hidden></div>
          {% endif %}
          <div class="neo-alchemist--dock-chips empty:hidden"></div>
          {% if dock_ops or dock_verbs %}
            <div class="neo-alchemist--dock-actions flex flex-wrap items-center gap-1.5">
              {% if dock_ops %}
                <div class="neo-alchemist--dock-ops flex flex-none items-center gap-1.5">{{ dock_ops }}</div>
              {% endif %}
              {% if dock_verbs %}
                <div class="neo-alchemist--dock-verbs flex flex-none items-center gap-1.5">{{ dock_verbs }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
        <div class="neo-alchemist--dock-prompt flex-none border-b px-3 py-2 text-sm bg-warning-50 text-warning-900" role="alert" hidden></div>
        <div id="{{ id }}-dock-body" class="neo-alchemist--dock-body neo-alchemist-manage--form-scroll flex flex-col flex-auto min-h-0 px-4">
          {%- if form and form_position == 'dock' -%}
            {{ form|neo_class('neo-alchemist-manage--form p-0 pt-4')|neo_class('mt-0', 'inner_attributes') }}
          {%- endif -%}
        </div>
      </aside>
    {% endif %}

  </div>
</div>
