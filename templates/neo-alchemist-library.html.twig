<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
{% for component in components %}
  <a{{ component.attributes.addClass('card relative overflow-hidden rounded focus hover:border-primary-500 transition')|neo_tooltip_trigger({placement: 'bottom', delay: '[300, 0]'}) }}>
    <div class="w-full h-44 overflow-hidden">
      <img src="{{ component.thumbnail }}" alt="{{ component.label }}" class="object-cover object-top w-full h-44 hover:scale-150 transition-all" />
    </div>
    <div class="flex absolute bottom-0 left-0 right-0 w-full bg-base-900/90 text-base-900-content text-xs px-2 py-1">
      <div class="truncate">{{ component.label }}</div>
    </div>
    {% if component.description %}
      {{ component.description|neo_tooltip_content }}
    {% endif %}
  </a>
{% endfor %}
</div>
