<div class="flex flex-col gap-6">
  {% if groups|length %}
    {% for group in groups %}
      <div class="card p-3">
        <div class="text-lg font-bold text-base-950">{{ group.label }}</div>
        <div class="text-xs text-base-700">{{ group.description }}</div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 my-2">
          {% for component in group.components %}
            <a{{ component.attributes.addClass('border relative overflow-hidden rounded focus hover:border-primary-500 transition')|neo_tooltip_trigger({placement: 'bottom', delay: '[300, 0]'}) }}>
              <div class="w-full h-30 overflow-hidden">
                <img src="{{ component.thumbnail }}" alt="{{ component.label }}" class="object-cover object-top w-full h-30 hover:object-bottom transition-all duration-700" />
              </div>
              <div class="flex gap-2 justify-center w-full bg-base-900/90 text-base-900-content text-xs px-2 py-1">
                <div class="truncate">{{ component.label }}</div>
              </div>
              {% if component.description %}
                {{ component.description|neo_tooltip_content }}
              {% endif %}
              {% if component.access %}
                <div class="absolute top-2 right-2">{{ component.access }}</div>
              {% endif %}
            </a>
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <div class="messages messages--warning">
      {{ 'No components are currently allowed to be created in this region.'|t }}
    </div>
  {% endif %}
</div>
