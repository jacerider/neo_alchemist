{%
  set shade_classes = 'absolute bg-base-0/60 backdrop-blur-sm'
%}
{%
  set overlay_classes = 'absolute border border-dashed shadow-lg'
%}
{%
  set element_classes = 'absolute'
%}
{%
  set event_classes = 'absolute cursor-pointer'
%}
{%
  set op_wrapper_classes = 'neo-alchemist--overlay-actions absolute flex items-center justify-center left-0 right-0 pointer-events-none transition'
%}
{%
  set op_classes = 'bg-primary-500 text-primary-500-content px-2 py-1 text-xs transition pointer-events-auto hover:bg-base-600 hover:text-base-600-content'
%}
<div class="neo-alchemist--panel neo-alchemist--panel-top fixed" style="display: none;" data-alchemist-ignore data-alchemist-nodrag>
  <div class="flex gap-2 items-center bg-base-900 text-base-900-content shadow py-2 px-4">
    <div class="flex gap-2">
      <div class="neo-alchemist--panel-title flex items-center gap-1 text-sm"></div>
    </div>
    <div class="flex gap-2 ml-auto">
      {{ close }}
    </div>
  </div>
</div>
<div class="neo-alchemist--panel neo-alchemist--panel-bottom fixed" style="display: none;" data-alchemist-ignore data-alchemist-nodrag>
  <div class="flex gap-2 items-center bg-base-900 text-base-900-content shadow py-2 px-4">
    <div class="flex gap-2">
      {% for op in ops %}
        {{ op }}
      {% endfor %}
    </div>
    <div class="flex ml-auto">
    </div>
  </div>
</div>
<div class="neo-alchemist--shade-base {{ shade_classes }}" data-alchemist-ignore></div>
<div class="neo-alchemist--overlay-base {{ overlay_classes }}" data-alchemist-ignore>
  <div class="neo-alchemist--overlay-label flex items-center gap-1 absolute bottom-full text-xs mb-1 transition">
    {# Label will go here. #}
  </div>
  <div class="{{ op_wrapper_classes }} bottom-full">
    {{ op_add_before|neo_class(['rounded-t', op_classes]) }}
  </div>
  <div class="{{ op_wrapper_classes }} top-full">
    {{ op_add_after|neo_class(['rounded-b', op_classes]) }}
  </div>
</div>
<div class="neo-alchemist--element-base {{ element_classes }}" data-alchemist-ignore></div>
<div class="neo-alchemist--event-base {{ event_classes }}" data-alchemist-ignore></div>
