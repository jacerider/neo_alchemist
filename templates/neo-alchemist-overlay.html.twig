{%
  set shade_classes = 'absolute bg-base-0/60 backdrop-blur-sm'
%}
{#
  The editor stamps data-node-type (what a thing is) and data-state (how it
  relates to the selection) on every outline; components-parent.css dresses
  each state. Border width never varies between states (only with the zoom,
  to stay one screen pixel): the label and the +/move clusters are
  anchored to this box with bottom/top-full, and the box is border-box with an
  inline width/height, so a wider border would resize the padding box and shift
  all of them. Emphasis is an outline and a shadow, which cost no layout.
#}
{%
  set overlay_classes = 'absolute border border-dashed'
%}
{%
  set element_classes = 'absolute'
%}
{%
  set event_classes = 'absolute cursor-pointer'
%}
{%
  set op_wrapper_classes = 'neo-alchemist--overlay-actions absolute flex items-center justify-center left-0 right-0 pointer-events-none transition-opacity'
%}
{%
  set op_add_classes = 'bg-primary-500 text-primary-500-content px-2 py-0.5 text-2xs transition pointer-events-auto hover:bg-primary-600 hover:text-primary-600-content'
%}
{%
  set op_move_classes = 'bg-primary-600 text-primary-600-content px-2 py-0.5 text-2xs transition pointer-events-auto hover:bg-primary-700 hover:text-primary-700-content'
%}
{#
  The breadcrumb and the selection's ops used to be two bars over the canvas.
  Both live in the inspector's header now (neo-alchemist-manage.html.twig).
#}
<div class="neo-alchemist--shade-base {{ shade_classes }}" data-alchemist-ignore></div>
<div class="neo-alchemist--overlay-base {{ overlay_classes }}" data-alchemist-ignore>
  {#
    transition-opacity, not transition: the editor translates this chip to keep
    it on screen while a tall component is scrolled through, and a transitioned
    transform would animate — and visibly lag — on every scroll frame.
  #}
  <div class="neo-alchemist--overlay-label flex items-center gap-1 absolute bottom-full text-xs mb-1 transition-opacity pointer-events-none whitespace-nowrap">
    {# Label will go here. #}
  </div>
  {# The op clusters are the only interactive part of an outline, so they are
     what must not start a pan. The outline itself is transparent chrome. #}
  {#
    Both clusters loop over the op inventory rather than naming ops: adding a
    positional op to EditorOpInventory places a button on the edge it acts on
    with no edit here. Move ops take the darker ramp, add ops the lighter one —
    keyed off the verb the record carries, not the op's name.
  #}
  <div class="{{ op_wrapper_classes }} neo-alchemist--overlay-actions-top gap-0.5 bottom-full" data-alchemist-nodrag>
    {% for op in outline_ops.top %}
      {{ op.link|neo_class(['rounded-t-lg', op.verb == 'move' ? op_move_classes : op_add_classes]) }}
    {% endfor %}
  </div>
  <div class="{{ op_wrapper_classes }} neo-alchemist--overlay-actions-bottom gap-0.5 top-full" data-alchemist-nodrag>
    {% for op in outline_ops.bottom %}
      {{ op.link|neo_class(['rounded-b-lg', op.verb == 'move' ? op_move_classes : op_add_classes]) }}
    {% endfor %}
  </div>
</div>
<div class="neo-alchemist--element-base {{ element_classes }}" data-alchemist-ignore></div>
<div class="neo-alchemist--event-base {{ event_classes }}" data-alchemist-ignore></div>
{#
  Insertion point. One is drawn at every boundary of a focused region, so the
  order of a region and the exact places a component can land are visible
  rather than inferred. The toolbar Add marks the tail seam with .is-target on
  hover, which is what makes "where will this go?" answerable before clicking.

  The label only earns its space on the seam being acted on; otherwise a stack
  of seams becomes a stack of words. The 600 shade, not 500, because "Add
  here" is text: white on a saturated 500 can fall under 4.5:1.
#}
<div class="neo-alchemist--seam-base group absolute flex items-center justify-center pointer-events-none" data-alchemist-ignore data-alchemist-nodrag>
  <div class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 transition bg-primary-400 group-hover:bg-primary-500 group-[.is-target]:bg-primary-500"></div>
  <button type="button" class="relative inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs leading-snug cursor-pointer pointer-events-auto transition bg-primary-600 text-primary-600-content group-hover:scale-105 group-[.is-target]:opacity-100 group-[.is-target]:scale-105 group-[.is-target]:animate-pulse motion-reduce:group-[.is-target]:animate-none">{{ icon('plus') }}<span class="hidden group-hover:inline group-[.is-target]:inline">{{ 'Add here'|t }}</span></button>
</div>
