<?php

/**
 * @file
 * Provides Alchemist blocks for use in Block layout.
 */

declare(strict_types=1);

use Drupal\Core\Block\BlockPluginInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\neo_alchemist_block\Entity\AlchemistBlock;
use Drupal\neo_alchemist_block\Entity\AlchemistBlockFieldConfig;
use Drupal\neo_alchemist_block\Plugin\Block\AlchemistBlock as AlchemistBlockPlugin;

/**
 * Implements hook_entity_bundle_field_info().
 */
function neo_alchemist_block_entity_bundle_field_info(EntityTypeInterface $entity_type, $bundle, array $base_field_definitions) {
  $fields = [];
  if ($entity_type->id() === AlchemistBlockFieldConfig::HOST_ENTITY_TYPE_ID) {
    $block = AlchemistBlock::load($bundle);
    if ($block) {
      $fields[AlchemistBlockFieldConfig::FIELD_NAME] = AlchemistBlockFieldConfig::createFromBlock($block);
    }
  }
  return $fields;
}

/**
 * Implements hook_block_view_BASE_BLOCK_ID_alter() for neo_alchemist_block.
 *
 * When the block's "Wrap in block markup" setting is disabled, appends a
 * #pre_render callback that strips the block.html.twig wrapper so the block's
 * components render directly at the root of the region.
 */
function neo_alchemist_block_block_view_neo_alchemist_block_alter(array &$build, BlockPluginInterface $block) {
  $configuration = $block->getConfiguration();
  if (empty($configuration['wrapper'])) {
    $build['#pre_render'][] = [AlchemistBlockPlugin::class, 'removeBlockWrapper'];
  }
}
