/**
 * Recursively updates a shape value within a nested props array.
 *
 * Searches for a matching shape key/value pair and replaces it with a new
 * key/value pair.
 *
 * @param array $props
 *   The props array to search through.
 * @param string $originalShapeKey
 *   The original shape key to find.
 * @param mixed $originalShapeValue
 *   The original shape value to match.
 * @param string $newShapeKey
 *   The new shape key to set.
 * @param mixed $newShapeValue
 *   The new shape value to set.
 * @param bool $found
 *   Reference flag indicating whether the value was found.
 *
 * @return array
 *   The updated props array.
 */
function neo_alchemist_recursive_update_value(array $props, $originalShapeKey, $originalShapeValue, $newShapeKey, $newShapeValue, &$found = FALSE) {
  foreach ($props as &$data) {
    if (is_array($data)) {
      if (array_key_exists($originalShapeKey, $data) && isset($data[$originalShapeKey]['value']) && $data[$originalShapeKey]['value'] == $originalShapeValue) {
        $data[$newShapeKey]['value'] = $newShapeValue;
        unset($data[$originalShapeKey]);
        $found = TRUE;
      }
      $data = neo_alchemist_recursive_update_value($data, $originalShapeKey, $originalShapeValue, $newShapeKey, $newShapeValue, $found);
    }
  }
  return $props;
}

/**
 * Implements hook_theme().
 */
function neo_alchemist_theme(): array {
  return [
    'html__neo_alchemist' => [
      'base hook' => 'html',
    ],
    'field__neo_component_tree' => [
      'base hook' => 'field',
    ],
    'neo_alchemist_entity' => [
      'render element' => 'elements',
    ],
    'neo_alchemist_manage' => [
      'variables' => [
        'id' => '',
        'iframe_url' => '',
        'iframe_start' => [],
        'iframe_end' => [],
        'form' => [],
        'form_position' => 'footer',
        'top_start' => [],
        'top_end' => [],
        'bottom_start' => [],
        'bottom_end' => [],
      ],
    ],
    'neo_alchemist_overlay' => [
      'variables' => [],
    ],
    'neo_alchemist_component_preview' => [
      'render element' => 'elements',
    ],
    'neo_alchemist_library' => [
      'variables' => [
        'groups' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 */
function neo_alchemist_page_attachments(&$attachments) {
  if (neo_alchemist_route_is_alchemist_preview()) {
    // Suppress markerio in alchemist preview routes.
    unset($attachments['#attached']['drupalSettings']['markerio']);
    if (!empty($attachments['#attached']['library'])) {
      $attachments['#attached']['library'] = array_filter($attachments['#attached']['library'], function ($library) {
        return $library !== 'markerio/markerio';
      });
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for html.
 */
function neo_alchemist_theme_suggestions_html_alter(array &$suggestions, array $variables) {
  if ($variables['html']['#is_alchemist'] ?? FALSE) {
    $suggestions = ['html__neo_alchemist'];
  }
}

/**
 * Implements hook_preprocess_field() for neo_component_tree.
 */
function template_preprocess_field__neo_component_tree(array &$variables) {
  $entityTypeId = $variables['entity_type'] ?? NULL;
  if ($entityTypeId === 'commerce_product_variation') {
    // In order to work with commerce product variation ajax updating, we need
    // to wrap the field in a container element so that the ajax class gets
    // added.
    $variables['tag'] = 'div';
  }
}

/**
 * Implements hook_preprocess_HOOK() for neo_alchemist_manage.
 */
function template_preprocess_neo_alchemist_manage(&$variables) {
  $iframeUrl = $variables['iframe_url'] ?? '';
  if ($iframeUrl) {
    $sizes = ['desktop', 'tablet', 'mobile'];
    $options = $iframeUrl->getOptions();
    $options['query']['id'] = $variables['id'] ?? '';
    foreach ($sizes as $size) {
      $options['query']['size'] = $size;
      $iframeUrl->setOptions($options);
      $variables["src_$size"] = $iframeUrl->toString();
    }
  }
  $variables['toolbar']['expand'] = [
    '#type' => 'link',
    '#title' => neo_icon('Expand', 'arrow-from-right')->iconOnly(),
    '#url' => Url::fromRoute('<current>'),
    '#tooltip' => t('Expand'),
    '#attributes' => [
      'class' => ['neo-alchemist-manage--expand text-base-0 hover:text-primary'],
    ],
  ];
  $variables['toolbar']['collapse'] = [
    '#type' => 'link',
    '#title' => neo_icon('Expand', 'arrow-from-left')->iconOnly(),
    '#url' => Url::fromRoute('<current>'),
    '#tooltip' => t('Collapse'),
    '#attributes' => [
      'class' => ['neo-alchemist-manage--collapse hidden text-base-0 hover:text-primary'],
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for neo_alchemist_component_preview.
 */
function template_preprocess_neo_alchemist_component_preview(&$variables) {
  $variables['content'] = [];
  $elements = $variables['elements'];
  foreach (Element::children($elements) as $child) {
    $variables['content'][$child] = $elements[$child];
  }
  $size = \Drupal::request()->query->get('size');
  if ($size) {
    $variables['attributes']['data-size'] = $size;
  }
}

/**
 * Implements hook_preprocess_HOOK() for neo_alchemist_overlay.
 */
function template_preprocess_neo_alchemist_overlay(&$variables) {
  $variables['close'] = [
    '#type' => 'link',
    '#title' => neo_icon_admin('Close', 'times')->iconOnly(),
    '#url' => Url::fromRoute('<current>'),
    '#tooltip' => t('Close'),
    '#attributes' => [
      'class' => ['neo-alchemist--close', 'btn', 'btn-alert', 'btn-xs'],
    ],
  ];

  $variables['ops'] = [];
  foreach ([
    'edit' => t('Edit'),
    'sort' => t('Sort'),
    'clone' => t('Clone'),
    'delete' => t('Delete'),
  ] as $op => $label) {
    $variables['ops'][$op] = [
      '#type' => 'link',
      '#title' => neo_icon_admin($label)->iconOnly(),
      '#url' => Url::fromRoute('<current>'),
      '#tooltip' => $label,
      '#tooltip_options' => [
        'placement' => 'top',
      ],
      '#attributes' => [
        'class' => ['neo-alchemist--op', 'btn', 'btn-primary', 'btn-xs'],
        'data-op' => $op,
      ],
    ];
  }

  // Ordered for the bottom bar, which renders them in a row and reads best
  // grouped by verb. The outline clusters pull each one out by name, so this
  // order does not affect them.
  $positionOps = [
    'add-before' => ['label' => t('Add Component Before'), 'short' => t('Before'), 'icon' => 'plus', 'placement' => 'top'],
    'add-after' => ['label' => t('Add Component After'), 'short' => t('After'), 'icon' => 'plus', 'placement' => 'bottom'],
    'move-up' => ['label' => t('Move Component Up'), 'short' => NULL, 'icon' => 'arrow-up', 'placement' => 'top'],
    'move-down' => ['label' => t('Move Component Down'), 'short' => NULL, 'icon' => 'arrow-down', 'placement' => 'bottom'],
  ];
  $variables['position_ops'] = [];
  foreach ($positionOps as $op => $config) {
    $varKey = 'op_' . str_replace('-', '_', $op);
    $variables[$varKey] = [
      '#type' => 'link',
      '#title' => neo_icon_admin($config['label'], $config['icon'])->iconOnly(),
      '#url' => Url::fromRoute('<current>'),
      '#tooltip' => $config['label'],
      '#tooltip_options' => [
        'placement' => $config['placement'],
      ],
      '#attributes' => [
        'class' => ['neo-alchemist--op'],
        'data-op' => $op,
      ],
    ];

    // The same ops again for the bottom bar. The outline copies sit on the
    // component's top and bottom edges, which are off screen whenever the
    // component is taller than the canvas viewport — so the only always-visible
    // route to them is the fixed bar. Both copies are driven by one access
    // decision; opsSet() shows every copy of an enabled op.
    //
    // Labelled, unlike everywhere else in the bar. Add-before and add-after
    // share the plus icon, which the outline disambiguates by putting each on
    // the edge it acts on. The bar has no such context — that is the whole
    // reason it is needed here — so it has to say which is which.
    $variables['position_ops'][$op] = [
      '#type' => 'link',
      '#title' => neo_icon_admin($config['short'], $config['icon']),
      '#url' => Url::fromRoute('<current>'),
      '#tooltip' => $config['label'],
      '#tooltip_options' => [
        'placement' => 'top',
      ],
      '#attributes' => [
        'class' => ['neo-alchemist--op', 'btn', 'btn-secondary', 'btn-xs'],
        'data-op' => $op,
      ],
    ];
  }
}

/**
 * Implements hook_ENTITY_TYPE_view_alter().
 *
 * When we have an alchemist field associated with a commerce product, we want
 * to alter the view to remove the variations since they will be rendered within
 * the alchemist field.
 */
function neo_alchemist_commerce_product_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  $hasNeoField = FALSE;
  foreach (Element::children($build) as $key) {
    if (!str_starts_with($key, 'variation_') && !empty($build[$key]['#neo_component_tree'])) {
      $hasNeoField = TRUE;
      break;
    }
  }
  if (!$hasNeoField) {
    return;
  }
  foreach (Element::children($build) as $key) {
    if (str_starts_with($key, 'variation_')) {
      unset($build[$key]);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function neo_alchemist_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $formObject = $form_state->getFormObject();
  if ($formObject instanceof FieldConfigEditForm) {
    $entity = $formObject->getEntity();
    if ($entity instanceof FieldConfigInterface && $entity->get('field_type') === 'neo_component_tree') {
      $form['field_storage']['#access'] = FALSE;
      $form['description']['#access'] = FALSE;
      $form['required']['#access'] = FALSE;
    }
  }
  if ($formObject instanceof ContentEntityFormInterface && in_array($formObject->getOperation(), ['default', 'edit'])) {
    $entity = $formObject->getEntity();
    if ($entity instanceof ContentEntityInterface && $entity->hasLinkTemplate('alchemist')) {

      $neoFields = \Drupal::service('entity_field.manager')->getFieldMapByFieldType('neo_component_tree')[$entity->getEntityTypeId()] ?? [];
      if (empty($neoFields)) {
        return;
      }

      // Only show the layout button when the entity has at least one field
      // whose layout (or custom regions, in hybrid mode) can be customized.
      if (empty(neo_alchemist_entity_component_field_definitions($entity, TRUE))) {
        return;
      }

      $form['actions']['alchemist'] = [
        '#type' => 'submit',
        '#value' => neo_icon('Save and Configure Layout', 'drafting-compass'),
        '#submit' => [
          '::submitForm',
          '::save',
          'neo_alchemist_content_entity_form_redirect',
        ],
        '#weight' => 100,
      ];
    }
  }
}

/**
 * Handle submit for alchemist-enabled entity forms.
 */
function neo_alchemist_content_entity_form_redirect(array $form, FormStateInterface $form_state) {
  $formObject = $form_state->getFormObject();
  if ($formObject instanceof ContentEntityFormInterface) {
    $entity = $formObject->getEntity();
    if ($entity->hasLinkTemplate('alchemist')) {
      // remove 'destination' query parameter from current request to avoid
      // interfering with our redirect.
      $request = \Drupal::request();
      $request->query->remove('destination');

      $form_state->setRedirectUrl($entity->toUrl('alchemist'));
    }
  }
}

/**
 * Implements hook_field_widget_single_element_WIDGET_TYPE_form_alter().
 *
 * @see \Drupal\neo_alchemist\MediaLibraryXbPropOpener
 */
function neo_alchemist_field_widget_single_element_media_library_widget_form_alter(array &$form, FormStateInterface $form_state, array $context): void {
  // Use an XB-specific media library opener, because the default opener assumes
  // the media library is opened for a field widget of a field instance on the
  // host entity type. That is not true for XB's "static prop sources".
  // @see \Drupal\neo_alchemist\PropSource\StaticPropSource
  // @see \Drupal\neo_alchemist\Form\ComponentPropsForm::buildForm()
  if ($form_state->get('neo_component_form') !== TRUE) {
    return;
  }

  // @see \Drupal\media_library\Plugin\Field\FieldWidget\MediaLibraryWidget::formElement()
  assert(array_key_exists('open_button', $form));
  assert(array_key_exists('#media_library_state', $form['open_button']));
  $old = $form['open_button']['#media_library_state'];
  assert($old instanceof MediaLibraryState);
  $form['open_button']['#media_library_state'] = MediaLibraryState::create(
    'neo_alchemist.media_library.opener',
    $old->getAllowedTypeIds(),
    $old->getSelectedTypeId(),
    $old->getAvailableSlots(),
    [
      // This single opener parameter is necessary.
      // @see \Drupal\neo_alchemist\MediaLibraryXbPropOpener::getSelectionResponse()
      'field_widget_id' => $old->getOpenerParameters()['field_widget_id'],
    ]
  );
}

/**
 * Implements hook_entity_type_alter().
 */
function neo_alchemist_entity_type_alter(array &$entity_types) {
  /** @var \Drupal\Core\Entity\EntityTypeInterface[] $entity_types */
  // A field's default layout can bake in a component tree, so the field config
  // depends on those components. The config dependency system loads dependents
  // straight from storage and calls onDependencyRemoval() on whatever class it
  // gets back, so the behaviour has to live on the class field_config itself
  // uses — it is a no-op for every other field type.
  // @see \Drupal\neo_alchemist\Entity\NeoFieldConfig
  if (isset($entity_types['field_config'])) {
    $entity_types['field_config']->setClass(NeoFieldConfig::class);
  }

  $configFactory = \Drupal::configFactory();
  foreach ($entity_types as $entityType) {
    if ($entityType instanceof ContentEntityTypeInterface) {
      $entityTypeId = $entityType->id();
      $names = $configFactory->listAll('field.field.' . $entityTypeId);
      foreach ($configFactory->loadMultiple($names) as $config) {
        if ($config->get('field_type') === 'neo_component_tree') {
          $baseRoute = NULL;
          if ($entityType->hasLinkTemplate('canonical')) {
            $baseRoute = $entityType->getLinkTemplate('canonical');
          }
          elseif ($entityType->hasLinkTemplate('edit-form')) {
            $baseRoute = $entityType->getLinkTemplate('edit-form');
          }
          if ($baseRoute) {
            $field = '{neo_field}';
            $component = '{neo_component}';
            $linkTemplates = [
              'alchemist' => "$baseRoute/alchemist",
              'alchemist.manage' => "$baseRoute/alchemist/$field",
              'alchemist.preview' => "$baseRoute/alchemist/$field/preview",
              'alchemist.library' => "$baseRoute/alchemist/$field/library",
              'alchemist.publish' => "$baseRoute/alchemist/$field/publish",
              'alchemist.revert' => "$baseRoute/alchemist/$field/revert",
              'alchemist.reset' => "$baseRoute/alchemist/$field/reset",
              'alchemist.sort' => "$baseRoute/alchemist/$field/sort",
              'alchemist.add' => "$baseRoute/alchemist/$field/add/$component",
              'alchemist.edit' => "$baseRoute/alchemist/$field/edit/$component",
              'alchemist.region' => "$baseRoute/alchemist/$field/region/$component",
              'alchemist.clone' => "$baseRoute/alchemist/$field/clone/$component",
              'alchemist.delete' => "$baseRoute/alchemist/$field/delete/$component",
            ];
            foreach ($linkTemplates as $key => $template) {
              $entityType->setLinkTemplate($key, $template);
            }
            $formClasses = [
              'alchemist' => InstanceComponentForm::class,
              'alchemist_publish' => InstanceComponentPublishForm::class,
              'alchemist_revert' => InstanceComponentRevertForm::class,
              'alchemist_reset' => InstanceComponentResetForm::class,
              'alchemist_sort' => InstanceComponentSortForm::class,
              'alchemist_edit' => InstanceComponentForm::class,
              'alchemist_delete' => InstanceComponentDeleteForm::class,
            ];
            foreach ($formClasses as $operation => $class) {
              $entityType->setFormClass($operation, $class);
            }
          }
          break;
        }
      }
    }
  }
}

/**
 * Implements hook_entity_insert().
 */
function neo_alchemist_entity_insert(EntityInterface $entity) {
  if ($entity instanceof FieldStorageConfigInterface && $entity->getType() === 'neo_component_tree') {
    \Drupal::state()->set('neo_alchemist.rebuild_needed', TRUE);
  }
}

/**
 * Implements hook_entity_delete().
 */
function neo_alchemist_entity_delete(EntityInterface $entity) {
  if ($entity instanceof FieldStorageConfigInterface && $entity->getType() === 'neo_component_tree') {
    \Drupal::state()->set('neo_alchemist.rebuild_needed', TRUE);
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for field_config entities.
 *
 * Remembers fields created during this request so that
 * neo_alchemist_entity_view_display_presave() can recognise Field UI's
 * automatic display placement.
 */
function neo_alchemist_field_config_insert(FieldConfigInterface $field): void {
  if ($field->isSyncing()) {
    return;
  }
  $created = &drupal_static('neo_alchemist_field_config_created', []);
  $created[$field->getTargetEntityTypeId()][$field->getTargetBundle()][$field->getName()] = TRUE;
}

/**
 * Implements hook_ENTITY_TYPE_presave() for entity_view_display entities.
 *
 * Field UI places every newly created field into the default view display. On
 * bundles rendered by Alchemist the fields are pulled into the component tree
 * rather than printed by the display, so an auto-placed field just shows up as
 * stray markup above the page. Strip the placement back out and leave the field
 * disabled until someone enables it on Manage display.
 *
 * @see \Drupal\field_ui\Form\FieldStorageCreationTrait::configureEntityViewDisplay()
 */
function neo_alchemist_entity_view_display_presave(EntityViewDisplayInterface $display): void {
  if ($display->isSyncing() || $display->isNew()) {
    return;
  }
  $created = &drupal_static('neo_alchemist_field_config_created', []);
  $fieldNames = $created[$display->getTargetEntityTypeId()][$display->getTargetBundle()] ?? [];
  if (!$fieldNames) {
    return;
  }

  $original = $display->getOriginal();
  if (!$original) {
    return;
  }
  // Only opt in displays that Alchemist already renders. When the component
  // tree field itself is the one being added the original display has no
  // Alchemist component yet, so that field stays visible as normal.
  $isAlchemist = (bool) array_filter($original->getComponents(), function (array $component) {
    return ($component['type'] ?? '') === 'neo_component_tree';
  });
  if (!$isAlchemist) {
    return;
  }

  foreach (array_keys($fieldNames) as $fieldName) {
    // Only undo placements this save is introducing, so re-saving the display
    // later never fights the Manage display form.
    if ($display->getComponent($fieldName) && !$original->getComponent($fieldName)) {
      $display->removeComponent($fieldName);
    }
  }
}

/**
 * Implements hook_alchemist_entity_bundle_field_info_alter().
 */
function neo_alchemist_entity_bundle_field_info_alter(&$fields, EntityTypeInterface $entity_type, $bundle) {
  // Alter the field config entity to use a custom class for component tree
  // fields.
  foreach ($fields as $id => $field) {
    /** @var \Drupal\Core\Field\Fiel $field */
    if ($field instanceof FieldConfigInterface && $field->getType() === 'neo_component_tree' && !$field instanceof ComponentFieldConfig) {
      $entity_class = 'Drupal\neo_alchemist\Entity\ComponentFieldConfig';
      $instance = new $entity_class($field->toArray(), 'field_config');
      $fields[$id] = $instance;
    }
  }
}

/**
 * Implements hook_entity_operation().
 */
function neo_alchemist_entity_operation(EntityInterface $entity) {
  $operations = [];
  if ($entity->hasLinkTemplate('alchemist') && $entity->access('update')) {
    $url = $entity->toUrl('alchemist');
    if ($url->access()) {
      $operations['alchemist'] = [
        'title' => t('Layout'),
        'url' => $entity->toUrl('alchemist'),
        'weight' => 50,
      ];
    }
  }
  else {
    $info = $entity->getEntityType();
    // Add manage fields and display links if this entity type is the bundle
    // of another and that type has field UI enabled.
    if (($bundle_of = $info->getBundleOf()) && \Drupal::entityTypeManager()->getDefinition($bundle_of)->getLinkTemplate('alchemist')) {
      $url = Url::fromRoute("entity.{$bundle_of}.field_ui.alchemist", [
        $entity->getEntityTypeId() => $entity->id(),
      ]);
      if ($url->access()) {
        $operations['alchemist'] = [
          'title' => t('Manage Layout'),
          'weight' => 15,
          'url' => $url,
        ];
      }
    }
  }
  return $operations;
}

/**
 * Implements hook_preprocess_block().
 */
function neo_alchemist_preprocess_block(&$variables) {
  if ($variables['base_plugin_id'] !== 'page_title_block') {
    return;
  }
  if (neo_alchemist_route_is_alchemist()) {
    $variables['attributes']['class'][] = 'sr-only';
  }
}

/**
 * Implements hook_preprocess_region__content().
 */
function neo_alchemist_preprocess_region__content(&$variables) {
  $variables['alchemist'] = neo_alchemist_route_is_alchemist();
}

/**
 * Prepares variables for product templates.
 *
 * Default template: commerce-product.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing rendered fields.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_neo_alchemist_entity(array &$variables) {
  $variables['tag'] = $variables['elements']['#tag'] ?? '';
  foreach (Element::children($variables['elements']) as $key) {
    // Only add alchemist fields.
    if (!empty($variables['elements'][$key]['#field_type']) && $variables['elements'][$key]['#field_type'] === 'neo_component_tree') {
      $variables['content'][$key] = $variables['elements'][$key];
    }
  }
}

/**
 * Implements hook_entity_view_alter().
 */
function neo_alchemist_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  // We consider only fieldable fields.
  $fieldableFields = array_filter($build, function ($key) {
    return str_starts_with($key, 'field_');
  }, ARRAY_FILTER_USE_KEY);
  $alchemistFields = array_filter($fieldableFields, function ($field) {
    return isset($field['#field_type']) && $field['#field_type'] === 'neo_component_tree';
  });
  $hasAlchemistFields = !empty($alchemistFields);
  // If we only have one fieldable field and it is a component tree field, we
  // render the entity using the neo_alchemist_entity theme.
  if (count($fieldableFields) === 1) {
    if ($hasAlchemistFields) {
      $build['#tag'] = '';
      if (!empty($build['#attributes'] ?? [])) {
        $build['#tag'] = 'div';
      }
      $build['#theme'] = 'neo_alchemist_entity';
    }
  }
  $isDefaultViewMode = in_array($display->getMode(), ['default', 'full']);
  if ($hasAlchemistFields && $entity instanceof NodeInterface && $isDefaultViewMode) {
    // Convert to full page so hardcoded not title does not show.
    $build['#page'] = TRUE;
    // Show revision message if not default revision.
    if (!$entity->isNew() && !$entity->isDefaultRevision()) {
      $dateFormatter = \Drupal::service('date.formatter');
      $info = t('Showing revision of %title from %date', [
        '%title' => $entity->label(),
        '%date' => $dateFormatter->format($entity->getRevisionCreationTime()),
      ]);
      \Drupal::messenger()->addWarning($info);
    }
  }
}

/**
 * Check if route is alchemist-enabled route.
 *
 * @return bool
 *   TRUE if the route is an alchemist-enabled route.
 */
function neo_alchemist_route_is_alchemist() {
  $isAlchemistRoute = &drupal_static(__FUNCTION__);
  if (isset($isAlchemistRoute)) {
    return $isAlchemistRoute;
  }
  $isAlchemistRoute = FALSE;
  $routeMatch = \Drupal::routeMatch();
  $routeObject = $routeMatch->getRouteObject();
  $entityTypeId = $routeObject->getOption('_neo_alchemist');
  if (!$entityTypeId) {
    return $isAlchemistRoute;
  }
  $entityView = $routeObject->getDefault('_entity_view') ?? $entityTypeId . '.default';
  [, $viewModeId] = explode('.', $entityView);
  if ($entity = $routeMatch->getParameter($entityTypeId)) {
    $bundle = $entity->bundle();
    $viewModeId = $viewModeId === 'full' ? 'default' : $viewModeId;
    $viewMode = \Drupal::service('entity_type.manager')
      ->getStorage('entity_view_display')
      ->load($entityTypeId . '.' . $bundle . '.' . $viewModeId);
    if ($viewMode) {
      foreach ($viewMode->getComponents() as $field_name => $component) {
        if (($component['type'] ?? '') === 'neo_component_tree') {
          $isAlchemistRoute = TRUE;
          break;
        }
      }
    }
  }
  return $isAlchemistRoute;
}

/**
 * Check if route is alchemist-enabled preview route.
 *
 * @return bool
 *   TRUE if the route is an alchemist-enabled route.
 */
function neo_alchemist_route_is_alchemist_preview() {
  $isAlchemistRoute = &drupal_static(__FUNCTION__);
  if (isset($isAlchemistRoute)) {
    return $isAlchemistRoute;
  }
  $isAlchemistRoute = FALSE;
  $routeMatch = \Drupal::routeMatch();
  $routeObject = $routeMatch->getRouteObject();
  $isAlchemistRoute = !empty($routeObject->getOption('_neo_alchemist_preview'));
  return $isAlchemistRoute;
}

/**
 * Implements hook_config_schema_info_alter().
 */
function neo_alchemist_config_schema_info_alter(&$definitions) {
  if (isset($definitions['block_settings'])) {
    foreach ($definitions as $key => $definition) {
      if (($definition['type'] ?? NULL) === 'block_settings') {
        $definitions[$key]['mapping']['label_display'] = [
          'type' => 'string',
          'label' => 'Label display',
        ];
      }
    }
  }
  if (isset($definitions['field.value.link'])) {
    $definitions['field.value.link']['mapping']['options']['mapping']['href'] = [
      'type' => 'string',
      'label' => 'Url HREF',
    ];
    $definitions['field.value.link']['mapping']['options']['mapping']['data-entity-type'] = [
      'type' => 'string',
      'label' => 'Entity type',
    ];
    $definitions['field.value.link']['mapping']['options']['mapping']['data-entity-uuid'] = [
      'type' => 'uuid',
      'label' => 'Entity UUID',
    ];
    $definitions['field.value.link']['mapping']['options']['mapping']['data-entity-substitution'] = [
      'type' => 'string',
      'label' => 'Entity substitution',
    ];
    // NeoLinkWidget::massageFormValues() folds the whole 'attributes' form
    // value into the root of 'options', so the widget's own attribute keys can
    // land alongside the Linkit ones above. They are read back out of
    // options['attributes'], but they have to be describable where they land.
    $definitions['field.value.link']['mapping']['options']['mapping']['target'] = [
      'type' => 'string',
      'label' => 'Target',
    ];
    $definitions['field.value.link']['mapping']['options']['mapping']['data-icon-position'] = [
      'type' => 'string',
      'label' => 'Icon position',
    ];
  }
}

/**
 * Implements hook_neo_token_image_alter().
 */
function neo_alchemist_neo_token_image_alter(&$uri, &$params, ContentEntityInterface $entity = NULL) {
  if (!$entity) {
    return;
  }
  // Never walk a component tree while a views value provider is executing:
  // result caching can serialize row entities, which computes metatag fields,
  // whose image token lands here — and initializing tree shapes at that point
  // executes their bound views mid-serialization (infinitely, when a search
  // page's own node appears in its results). The head-of-page metatag pass
  // runs outside any execution and resolves the image normally.
  if (\Drupal\neo_alchemist\Plugin\ComponentValue\ViewsValue::isExecuting()) {
    return;
  }
  if ($fieldName = neo_alchemist_get_entity_field_name($entity)) {
    if (!$entity->hasField($fieldName)) {
      return;
    }
    $field = $entity->get($fieldName);
    if (!$field instanceof NeoComponentTreeList) {
      return;
    }
    $shape = $field->getQuery()
      ->filterByRef('image')
      ->filterNonEmpty()
      ->first();

    if ($shape && !empty($shapeValue = $shape->getValue()['uri'] ?? NULL)) {
      $uri = $shapeValue;
    }
  }
}

/**
 * Gets the Alchemist component field definitions applicable to an entity.
 *
 * Filters the entity's field definitions down to Alchemist component tree
 * fields, then lets modules narrow the set per entity via
 * hook_neo_alchemist_entity_component_fields_alter() (e.g. to the single
 * level-matched field on a taxonomy term).
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity to get the component field definitions for.
 * @param bool $allow_custom_only
 *   (optional) When TRUE, only fields that allow per-entity customization are
 *   returned. Defaults to FALSE.
 *
 * @return \Drupal\neo_alchemist\ComponentFieldConfigInterface[]
 *   The applicable component field definitions, keyed by field name.
 */
function neo_alchemist_entity_component_field_definitions(ContentEntityInterface $entity, bool $allow_custom_only = FALSE): array {
  $fieldDefinitions = array_filter($entity->getFieldDefinitions(), function ($field) use ($allow_custom_only) {
    return $field instanceof ComponentFieldConfigInterface && (!$allow_custom_only || $field->allowCustom() || $field->isHybrid());
  });
  \Drupal::moduleHandler()->alter('neo_alchemist_entity_component_fields', $fieldDefinitions, $entity);
  return $fieldDefinitions;
}

/**
 * Gets the name of the Neo Alchemist field for a given entity.
 *
 * This function searches for fields that use the 'neo_component_tree'
 * formatter in the entity's default view display, then narrows them to the
 * ones applicable to this specific entity. The display lookup is cached per
 * entity type and bundle.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity to check.
 *
 * @return string|null
 *   The name of the first applicable Neo Alchemist field, or NULL if none
 *   exists.
 */
function neo_alchemist_get_entity_field_name(ContentEntityInterface $entity) {
  $cache = &drupal_static(__FUNCTION__, []);
  $entityTypeId = $entity->getEntityTypeId();
  $bundle = $entity->bundle();
  if (!isset($cache[$entityTypeId][$bundle])) {
    /** @var \Drupal\Core\Entity\EntityDisplayRepositoryInterface $entity_display_repository */
    $entity_display_repository = \Drupal::service('entity_display.repository');
    $display = $entity_display_repository->getViewDisplay($entityTypeId, $bundle);
    $alchemistFields = array_filter($display->getComponents(), function ($component) {
      return isset($component['type']) && $component['type'] === 'neo_component_tree';
    });
    $cache[$entityTypeId][$bundle] = array_keys($alchemistFields);
  }
  if (!$cache[$entityTypeId][$bundle]) {
    return NULL;
  }
  $fieldNames = array_intersect($cache[$entityTypeId][$bundle], array_keys(neo_alchemist_entity_component_field_definitions($entity)));
  return $fieldNames ? reset($fieldNames) : NULL;
}
