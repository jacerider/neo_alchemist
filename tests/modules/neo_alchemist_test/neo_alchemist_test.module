<?php

/**
 * @file
 * Hook implementations for the neo_alchemist test fixtures.
 */

declare(strict_types=1);

use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\neo_alchemist\Shape\ComponentShapePluginInterface;
use Drupal\neo_alchemist_test\TestEntityComponentFieldsAlter;
use Drupal\neo_alchemist_test\TestMenuItemAlter;

/**
 * Implements hook_neo_alchemist_menu_value_item_alter().
 *
 * Delegates to TestMenuItemAlter, which is inert unless a test switches a
 * mode on — so simply enabling the fixture module cannot perturb any other
 * test's menu values.
 */
function neo_alchemist_test_neo_alchemist_menu_value_item_alter(?array &$entry, array $item, ComponentShapePluginInterface $shape): void {
  TestMenuItemAlter::apply($entry, $item, $shape);
}

/**
 * Implements hook_neo_alchemist_entity_component_fields_alter().
 *
 * Delegates to TestEntityComponentFieldsAlter, which is inert unless a test
 * names the fields to keep — so simply enabling the fixture module cannot
 * narrow any other test's field set.
 */
function neo_alchemist_test_neo_alchemist_entity_component_fields_alter(array &$fieldDefinitions, ContentEntityInterface $entity): void {
  TestEntityComponentFieldsAlter::apply($fieldDefinitions, $entity);
}
